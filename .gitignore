node_modules
.next
*.tsbuildinfo

# Environment files - never commit real secrets. .env in this repo is
# a placeholder template; this rule protects against anyone (including
# future contributors) accidentally committing real values over it.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Signing keys/credentials - never commit these regardless of where
# they end up in the tree (android/.gitignore also covers the Android
# app module specifically).
*.jks
*.keystore
*.p8
*.p12
keystore.properties
