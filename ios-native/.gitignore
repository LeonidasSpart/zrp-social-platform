# Xcode build output and per-user state. Nothing generated by a build
# belongs in the repository.
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager resolution state. There are no third-party
# dependencies yet - the app is built entirely on Apple frameworks
# (SwiftUI, Foundation, Security, AVKit, OSLog) - so nothing needs
# resolving. If a dependency is ever genuinely required, Package.resolved
# SHOULD be committed and this line removed.
.swiftpm/

# Signing material must never be committed. Certificates and profiles are
# supplied to CI as secrets at build time.
*.mobileprovision
*.p12
*.cer
