<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ZRP Social</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!--
	  Declared false because the app uses only HTTPS/TLS via URLSession -
	  the "exempt" standard-cryptography case. It carries no custom or
	  proprietary encryption. This is what removes the export-compliance
	  question on every App Store Connect upload; revisit it only if the
	  app ever ships non-exempt cryptography of its own.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  No ATS exceptions. Every request goes to https://zrp.one, and media
	  comes from HTTPS CDN URLs the API returns. Nothing here needs
	  NSAllowsArbitraryLoads, and it must never be added to work around a
	  TLS failure.
	-->

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!--
	  iPhone is portrait-only (the feed, composer, and story surfaces are
	  all designed as a single portrait column, matching the web app's
	  mobile layout). iPad rotates freely because Split View and Slide
	  Over both require it, and the iPad layouts are genuinely responsive
	  rather than a scaled-up phone UI.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>

	<!--
	  ZRP Music plays audio that must continue when the app is
	  backgrounded or the screen locks - that is the whole point of a
	  music player, and it is what MPNowPlayingInfoCenter and the lock
	  screen transport controls attach to. This is the first phase that
	  genuinely exercises a background mode, so it is the first phase
	  that declares one.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!--
	  Still deliberately absent, because nothing exercises them yet -
	  Apple rejects permissions an app does not actually use:
	    NSPhotoLibraryUsageDescription  PhotosPicker is out-of-process
	                                    and needs no permission at all
	    NSCameraUsageDescription        camera capture, Phase 7b
	    NSMicrophoneUsageDescription    in-app video capture, Phase 9b
	    UIBackgroundModes remote-notification
	                                    push, BLOCKED on B3
	  See ios-native/PARITY.md.
	-->
</dict>
</plist>
