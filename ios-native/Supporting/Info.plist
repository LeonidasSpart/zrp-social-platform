<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ZRP Social</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!--
	  Declared false because the app uses only HTTPS/TLS via URLSession -
	  the "exempt" standard-cryptography case. It carries no custom or
	  proprietary encryption. This is what removes the export-compliance
	  question on every App Store Connect upload; revisit it only if the
	  app ever ships non-exempt cryptography of its own.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  No ATS exceptions. Every request goes to https://zrp.one, and media
	  comes from HTTPS CDN URLs the API returns. Nothing here needs
	  NSAllowsArbitraryLoads, and it must never be added to work around a
	  TLS failure.
	-->

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!--
	  iPhone is portrait-only (the feed, composer, and story surfaces are
	  all designed as a single portrait column, matching the web app's
	  mobile layout). iPad rotates freely because Split View and Slide
	  Over both require it, and the iPad layouts are genuinely responsive
	  rather than a scaled-up phone UI.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>

	<!--
	  ZRP Music plays audio that must continue when the app is
	  backgrounded or the screen locks - that is the whole point of a
	  music player, and it is what MPNowPlayingInfoCenter and the lock
	  screen transport controls attach to.

	  "remote-notification": background push delivery, driven by
	  AppDelegate/PushCoordinator (Task #6). Genuinely needed - without
	  it, a background push can still show a system banner, but this
	  app's own didReceive(response:) tap-routing has no code path to
	  run in until the user taps it and the app itself launches anyway,
	  so silent/data-only pushes (used nowhere today, but the capability
	  a correct implementation declares) would otherwise never reach it.

	  "voip": REQUIRED, not optional, for PKPushRegistry to be entitled
	  to receive VoIP pushes at all - see VoipPushCoordinator.swift. This
	  is what actually lets an incoming call ring while the app is
	  backgrounded, suspended, or terminated.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>

	<!--
	  Voice messages in chat record audio, so the microphone permission
	  is now genuinely used and is declared. This is not optional
	  paperwork: iOS TERMINATES the process the moment an app asks for
	  the microphone without this key - it is a crash, not a denial.
	  Removing it while VoiceRecorder exists would take the app down the
	  first time somebody tapped the mic button.
	-->
	<!--
	  Also used by Live Audio and Live Video rooms (LiveKit
	  setMicrophone(enabled:)) and by calls, so the purpose string names
	  every place the microphone is genuinely used - App Review rejects a
	  purpose string that undersells what the permission is for.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>ZRP uses the microphone so you can speak in calls and live rooms, and to record voice messages you send in chat.</string>

	<!--
	  The chat composer's Camera button (ConversationView/
	  GroupConversationView) now genuinely captures a photo with
	  UIImagePickerController(sourceType: .camera) to send in a message -
	  the same real capability the web composer's capture="environment"
	  file input and Android's TakePicture() launcher gained in the same
	  pass. iOS TERMINATES the process the moment the camera is invoked
	  without this key, so it is not optional paperwork: removing it
	  while CameraCapture.swift exists would take the app down the first
	  time somebody tapped the Camera button.
	-->
	<!--
	  Live Video rooms publish the camera (LiveKit setCamera(enabled:))
	  once an on-camera participant turns it on - never automatically on
	  join - and video calls use it too, so the purpose string covers both.
	-->
	<key>NSCameraUsageDescription</key>
	<string>ZRP uses the camera so you can appear on video in calls and live video rooms, and to take a photo to send in a message.</string>

	<!--
	  Still deliberately absent. Apple rejects permissions an app does
	  not actually use, and this would be exactly that:
	    NSPhotoLibraryUsageDescription  PhotosPicker is out-of-process
	                                    and needs no permission at all
	  See ios-native/PARITY.md.
	-->
</dict>
</plist>
