model Mute {
  id String @id @default(cuid())

  muterId String
  muter   User   @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)

  mutedId String
  muted   User   @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

// "Notify me when this account posts" - a per-viewer, per-author opt-in,
// independent of Follow (you can subscribe to someone you don't follow -
// e.g. a public account - and following someone does not imply a
// subscription). Row existence IS the enabled state, same convention as
// Follow/Mute/Blocked: there is no `enabled` column to keep in sync,
// unsubscribing just deletes the row, so "subscribed" and "has a row"
// can never drift apart.
model PostSubscription {
  id String @id @default(cuid())

  subscriberId String
  subscriber   User   @relation("PostSubscriptionSubscriber", fields: [subscriberId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("PostSubscriptionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([subscriberId, authorId])
  @@index([subscriberId])
  @@index([authorId])
}

// One row per device that has registered for native push (Firebase
// Cloud Messaging) - separate from PushSubscription above, which is
// browser Web Push (VAPID) and uses a completely different delivery
// mechanism. The token itself is what's unique (a re-login on the same
// device re-registers the same token under whichever account is
// signed in then, which is why registration is an upsert keyed on
// `token` rather than on `userId`). Sending from these tokens goes
// through src/lib/fcm.ts, using the Firebase service-account
// credential configured server-side (FIREBASE_SERVICE_ACCOUNT_JSON).
model FcmToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String @unique
  // "android" or "ios" - caller-supplied via POST /api/push/fcm, and
  // defaults to "android" for any request (or client build) that
  // doesn't send one, since that was the only platform this ever
  // supported until the iOS app existed.
  platform String @default("android")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// A PushKit VoIP token, distinct from FcmToken: it comes from
// PKPushRegistry (not UNUserNotificationCenter/FCM), is delivered over
// the APNs "voip" topic instead of the ordinary alert topic, and a
// device that has one still separately registers an FcmToken for
// ordinary pushes - the two are independent subscriptions on iOS.
// "ios" is the only platform today (Android/Web have no VoIP-push
// equivalent - see ios-native/PARITY.md), but the column exists for
// the same reason FcmToken.platform does.
model VoipToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String @unique
  platform String @default("ios")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("Notification_user", fields: [userId], references: [id], onDelete: Cascade)

  type String

  fromUserId String
  fromUser   User   @relation("Notification_fromUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation("Notification_post", fields: [postId], references: [id], onDelete: Cascade)

  // Disambiguates a comment-level notification (comment_like,
  // comment_repost) from another comment on the SAME post by the SAME
  // actor - without this, retracting one comment's notification on
  // unlike/un-repost could delete the wrong comment's notification,
  // since both only had postId+type+fromUserId to match on. Nullable:
  // most notification types aren't comment-scoped at all.
  commentId String?
  comment   Comment? @relation("Notification_comment", fields: [commentId], references: [id], onDelete: Cascade)

  // Links an "announcement"-type notification back to the broadcast
  // that produced it. Nullable: every other notification type leaves
  // this null, and Postgres does not enforce uniqueness across NULLs,
  // so @@unique([announcementId, userId]) below only ever constrains
  // the announcement rows - it has no effect on ordinary notifications.
  // That uniqueness is what makes batch re-processing after a crash/
  // restart idempotent (see dispatch.ts): re-inserting the same
  // (announcementId, userId) pair is a no-op via createMany's
  // skipDuplicates rather than a duplicate notification.
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([fromUserId])
  @@index([commentId])
}

// A single admin-authored message broadcast to all eligible ZRP
// members (today's only supported target - see dispatch.ts/eligibility.ts
// for what "eligible" excludes). Sits ON TOP of the existing
// Notification + push (FCM/APNs/Web Push) infrastructure rather than
// duplicating it: sending a broadcast creates one Notification row per
// eligible recipient (announcementId set, fromUserId set to a single
// reserved system account - see announcements/system-user.ts) and
// calls the existing sendPushNotification() per recipient, exactly as
// any other notification type would. No second push pipeline, no
// second notification center.
model Announcement {
  id    String @id @default(cuid())
  title String
  body  String @db.Text

  // Plain string + a TS union (src/lib/announcements/types.ts), not a
  // Prisma enum - matching Notification.type's own established
  // convention in this codebase rather than introducing the first
  // Prisma enum for this domain.
  type String @default("ANNOUNCEMENT")

  status AnnouncementStatus @default(DRAFT)

  imageUrl  String?
  actionUrl String?

  // Loose reference, not a Prisma relation/FK - same convention as
  // AuditLog.actorId. A real FK with onDelete:Cascade here would mean
  // deleting the admin's account later cascade-deletes this
  // Announcement row and, via Notification.announcementId's own
  // cascade, every recipient's Notification row with it - a single
  // account deletion silently wiping a broadcast's entire history for
  // everyone else. A loose id avoids that blast radius entirely.
  createdById String

  scheduledAt   DateTime?
  sendStartedAt DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  // Progress/resume cursor for the batch processor - set once eligibility
  // is computed at send time, then advanced by each batch. See
  // src/lib/announcements/dispatch.ts.
  totalRecipients   Int     @default(0)
  processedCount    Int     @default(0)
  failedBatchCount  Int     @default(0)
  lastProcessedUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@index([createdById])
}

model Message {
  id String @id @default(cuid())

  content  String  @db.Text
  imageUrl String?

  senderId String
  sender   User   @relation("Message_sender", fields: [senderId], references: [id], onDelete: Cascade)

  // Nullable, not removed: a real GROUP message has no single receiver
  // (see ConversationParticipant's own KDoc), so receiverId is null on
  // those rows going forward. Every EXISTING 1:1 message row already
  // has a real receiverId and keeps it - this relaxation only widens
  // what a NEW row is allowed to omit, it never touches existing data.
  // GET /messages/{userId}'s own 1:1 query (senderId/receiverId based)
  // is completely unaffected either way.
  receiverId String?
  receiver   User?   @relation("Message_receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // Null for every existing (and every future) 1:1 message - those
  // keep working through senderId/receiverId exactly as before. Set
  // only on a message sent inside a real GROUP (or, in principle, a
  // DIRECT) Conversation - see Conversation's own KDoc for why 1:1
  // history was deliberately NOT backfilled onto this column.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  read   Boolean @default(false)
  edited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Set when this message is a reply to someone's Story, sent through
  // this same DM channel rather than a separate story-reply system -
  // the story is never publicly commented on, only privately replied to
  // its owner, mirroring StoryLike's private/per-viewer shape. SetNull
  // (not Cascade), same reasoning as replyToId: a Story is never
  // hard-deleted by any job in this codebase (it just stops being
  // served once expired), but if it ever is removed, the reply itself
  // is a real conversation message and must survive that.
  storyId String?
  story   Story?  @relation(fields: [storyId], references: [id], onDelete: SetNull)

  reactions MessageReaction[]

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([senderId, receiverId])
  @@index([replyToId])
  @@index([conversationId, createdAt])
  @@index([storyId])
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationParticipantRole {
  OWNER
  MEMBER
}

// A real GROUP conversation - deliberately NOT used to represent
// existing 1:1 messaging retroactively. Every 1:1 message already in
// this database (and every new one - see Message's own KDoc) keeps
// working through senderId/receiverId with zero Conversation row
// involved; backfilling one Conversation per historical DM pair was
// considered and rejected as unnecessary migration risk for no real
// benefit, since senderId/receiverId already fully identifies a DM
// pair. This model exists purely to give a GROUP conversation the
// participant list, name and read-state a plain sender/receiver pair
// structurally cannot express.
model Conversation {
  id   String           @id @default(cuid())
  type ConversationType

  // GROUP-only presentation - always null for the DIRECT value this
  // enum allows for future use, since a direct thread's name/avatar is
  // always derived from the other participant instead, matching how
  // 1:1 messaging already renders.
  name      String?
  avatarUrl String? @db.Text

  createdById String?
  createdBy   User?   @relation("Conversation_createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ConversationParticipantRole @default(MEMBER)

  joinedAt DateTime @default(now())

  // Per-participant read pointer, not a per-message Boolean fan-out:
  // a GROUP message's read state genuinely differs per participant, so
  // "unread" is computed server-side as messages in this conversation
  // newer than lastReadAt, the same efficient pattern real group-chat
  // products use instead of one row per (message, participant) pair.
  lastReadAt DateTime?

  // Removing a participant (kick, or leaving) deletes this row, which
  // is the actual authorization boundary every group message-read/
  // send/participant-list check queries against - it is never a soft
  // "active: false" flag to remember to filter on. Their past messages
  // stay in the conversation (Message.senderId is untouched), only
  // their own future access is revoked.
  @@unique([conversationId, userId])
  @@index([userId])
}

model MessageReaction {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji String

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model Poll {
  id String @id @default(cuid())

  question String   @db.Text
  options  String[]

  votes Json?

  post Post?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes_user PollVote[]
}

model PollVote {
  id String @id @default(cuid())

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  optionIndex Int

  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model Gif {
  id String @id @default(cuid())

  url    String
  title  String?
  width  Int?
  height Int?

  createdAt DateTime @default(now())
}

model Blocked {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// "Delete conversation" on a 1:1 DM (DELETE /api/messages/conversation/
// [userId]) used to hard-delete every Message row between the two users -
// destroying the OTHER participant's copy of the conversation too, with
// no consent, no undo, and UI copy ("Delete your conversation with
// {name}") that only ever promised to affect the caller's own view. This
// row makes that promise real: it marks everything up to clearedBefore as
// hidden from userId's own view only. otherUserId's messages, and the
// underlying Message rows themselves, are never touched - a message sent
// after clearedBefore makes the conversation reappear normally.
model ConversationClearance {
  id String @id @default(cuid())

  userId String
  user   User   @relation("ConversationClearanceUser", fields: [userId], references: [id], onDelete: Cascade)

  otherUserId String
  otherUser   User   @relation("ConversationClearanceOtherUser", fields: [otherUserId], references: [id], onDelete: Cascade)

  clearedBefore DateTime @default(now())

  @@unique([userId, otherUserId])
  @@index([otherUserId])
}

model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // SetNull rather than Cascade: a moderation action that deletes the
  // reported post/comment must NOT also delete the Report row recording
  // why - that would erase the moderation-transparency audit trail (and
  // any appeal referencing it) at the exact moment the action it
  // describes is carried out.
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  reason  String
  details String? @db.Text

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionType String?
  actionNote String?   @db.Text
  actionedAt DateTime?

  // Denormalized at the moment an action is taken (see PUT
  // /api/admin/reports/[id]): the post/comment author may become
  // unreachable later (content deleted, SetNull above), but the person
  // an action was actually taken against must still be identifiable so
  // they can be shown - and file - an appeal.
  targetUserId String?
  targetUser   User?   @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Third optional polymorphic target, same pattern as postId/commentId
  // above - reuses this entire reporting/moderation/appeals/transparency
  // system for marketplace listings instead of building a parallel one.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  // Fourth polymorphic target, same pattern again - reuses the same
  // reporting/moderation system for ZRP PLAY user-created challenges.
  challengeId String?
  challenge   PlayChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  // Fifth polymorphic target - ZRP OPPORTUNITY listings.
  opportunityId String?
  opportunity   OpportunityListing? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  // Sixth polymorphic target - ZRP HELP campaigns.
  campaignId String?
  campaign   HelpCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  // Seventh polymorphic target - a bare profile/account report (e.g.
  // harassment, impersonation, fake account, ban evasion) that isn't
  // about any single post/comment/listing. Distinct from targetUserId
  // above: that field is only populated once an admin takes action and
  // a post/comment's own author has become unreachable, whereas
  // reportedUserId is the report's actual subject from the moment it's
  // filed - set whenever every other polymorphic target above is null.
  // SetNull (not Cascade) for the same audit-trail reason as postId/
  // commentId: deleting the reported account must not erase the record
  // of why they were reported.
  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  // Eighth polymorphic target - a Live Audio room (e.g. abusive/illegal
  // content spoken in a room, harassment by a host/speaker). SetNull,
  // same audit-trail reasoning as every other target above: a room
  // being cleaned up/deleted must not erase why it was reported.
  liveAudioRoomId String?
  liveAudioRoom   LiveAudioRoom? @relation(fields: [liveAudioRoomId], references: [id], onDelete: SetNull)

  appeals Appeal[]

  @@index([postId])
  @@index([commentId])
  @@index([listingId])
  @@index([challengeId])
  @@index([opportunityId])
  @@index([campaignId])
  @@index([reportedUserId])
  @@index([liveAudioRoomId])
  @@index([status])
  @@index([reporterId])
  @@index([targetUserId])
}

