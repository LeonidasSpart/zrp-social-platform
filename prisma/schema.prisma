// ZRP Market Plus: luxury-only listings marketplace. Deliberately NOT
// a payments/escrow system - price is informational, a deal is closed
// off-platform between buyer and seller after they connect via the
// existing messaging system. Mirrors AdCampaign's moderation shape
// (PENDING_REVIEW by default, staff approve/reject, rejectionReason +
// reviewedBy/reviewedAt) since that's the closest existing analog to
// "user-submitted content that must pass moderation before going
// live" for something other than a Post.
model Listing {
  id String @id @default(cuid())

  sellerId String
  seller   User   @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  category    ListingCategory
  title       String
  description String          @db.Text

  // Either a real price or priceOnRequest - validated together at the
  // API layer, not enforceable as a DB constraint with Prisma alone.
  price          Decimal? @db.Decimal(18, 2)
  currency       String   @default("USD")
  priceOnRequest Boolean  @default(false)

  location String?

  imageUrls String[] @default([])
  videoUrl  String?

  status          ListingStatus @default(PENDING_REVIEW)
  rejectionReason String?       @db.Text
  reviewedBy      String?
  reviewedAt      DateTime?

  views Int @default(0)

  // Listings aren't meant to sit forever - a stale "for sale" luxury
  // asset is exactly the kind of thing that erodes trust in a
  // marketplace. Set on approval (90 days out); expired listings stop
  // showing in browse/search but aren't deleted.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites ListingFavorite[]
  reports   Report[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([status, category])
  @@index([status, expiresAt])
  @@index([createdAt])
}

