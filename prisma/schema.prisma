generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  JOURNALIST
}

enum JournalistStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PostType {
  POST
  RECRUITMENT
  ARTICLE
}

enum TeamRole {
  ADMIN
  EDITOR
  VIEWER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum TicketCategory {
  GENERAL
  ACCOUNT
  PRIVACY
  CONTENT
  MODERATION
  PAYMENT
  MONETISATION
  BUG
  FEATURE_REQUEST
  SECURITY
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_REPLY
  RESOLVED
  CLOSED
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum AdBidType {
  CPC
  CPM
}

enum NewsArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum NewsArticleCategory {
  WORLD
  EUROPE
  SWITZERLAND
  POLITICS
  BUSINESS
  TECHNOLOGY
  CRYPTO
  SCIENCE
  SPORTS
  CULTURE
  COMMUNITY
  GAMING
}

enum ListingCategory {
  LUXURY_CARS
  YACHTS_BOATS
  PRIVATE_AIRCRAFT
  LUXURY_HOTELS_RESORTS
  LUXURY_REAL_ESTATE
  WATCHES_JEWELRY
  OTHER_LUXURY
}

// DRAFT is unused today (creation always goes straight to
// PENDING_REVIEW, same as AdCampaign) but kept for a future
// save-without-submitting flow, matching AdCampaignStatus's own
// unused-DRAFT precedent.
enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SOLD
  EXPIRED
  REMOVED
}

// ─── ZRP PLAY ──────────────────────────────────────────────────────

enum PlayChallengeType {
  TRIVIA
  MEMORY
  LOGIC
}

// Same live-immediately, reportable-after-the-fact model as Post
// (not the PENDING_REVIEW admin-approval gate used by Listing/AdCampaign) -
// challenge content is low-risk text/puzzle content, not a real-world
// commerce or ad-spend surface.
enum PlayChallengeStatus {
  ACTIVE
  REMOVED
}

enum PlayDuelStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  EXPIRED
}

// ─── ZRP OPPORTUNITY ────────────────────────────────────────────────
enum OpportunityType {
  JOB
  REMOTE
  INTERNSHIP
  SCHOLARSHIP
  MENTORSHIP
  FREELANCE
  PARTNERSHIP
  SPONSORSHIP
  HACKATHON
  TRAINING
  COLLABORATION
}

// Same PENDING_REVIEW -> staff approve/reject -> live shape as Listing
// (see the comment on Listing below) - a fake job/scholarship posting
// is exactly the kind of thing that needs a human review gate before
// it's visible to the community.
enum OpportunityStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  EXPIRED
  CLOSED
  REMOVED
}

enum OpportunityApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ─── ZRP HELP ───────────────────────────────────────────────────────
enum HelpCategory {
  WAR
  DISASTER
  POVERTY
  EMERGENCY
  OTHER
}

enum HelpNeedType {
  MONEY
  SUPPLIES
  SKILLS
  VOLUNTEERS
}

enum HelpCampaignStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  COMPLETED
  CLOSED
  REMOVED
}

enum HelpOfferStatus {
  PENDING
  ACKNOWLEDGED
  FULFILLED
  DECLINED
}

// ─── ZRP NEWS NETWORK ────────────────────────────────────────────────
// Enums for the automated editorial system. Deliberately separate from
// NewsArticleCategory: that enum is the vocabulary of the *human*
// journalist workflow and is hard-wired into the /news page filters and
// their translation keys. Widening it to the 25 automation topics would
// churn that UI (and eleven translation files) for no benefit, so the
// automation gets its own topic vocabulary and leaves the journalist
// one untouched.

enum NewsRegion {
  GLOBAL
  NORTH_AMERICA
  SOUTH_AMERICA
  EUROPE
  AFRICA
  ASIA
  MIDDLE_EAST
  OCEANIA
}

enum NewsTopic {
  WORLD
  POLITICS
  BUSINESS
  ECONOMY
  TECHNOLOGY
  AI
  SCIENCE
  HEALTH
  CRYPTO
  FINANCE
  SPORTS
  ENTERTAINMENT
  CULTURE
  ENVIRONMENT
  CLIMATE
  SECURITY
  EDUCATION
  TRAVEL
  TOURISM
  TRANSPORTATION
  AVIATION
  AUTOMOTIVE
  LIFESTYLE
  LOCAL
  BREAKING
  GAMING
}

enum NewsSourceStatus {
  HEALTHY
  WARNING
  FAILED
  DISABLED
}

enum NewsStoryStatus {
  NEW
  READY
  PUBLISHED
  REJECTED
  SUPERSEDED
}

// How well corroborated a story is. Never inferred optimistically: a
// story only reaches CONFIRMED when independent sources of sufficient
// trust agree, and the label is rendered verbatim in the published post
// so a developing story is never presented as settled fact.
enum NewsConfidence {
  CONFIRMED
  DEVELOPING
  UNCONFIRMED
}

enum NewsRenditionStatus {
  PENDING
  READY
  FAILED
  REJECTED
}

enum NewsPublicationStatus {
  SCHEDULED
  PUBLISHED
  FAILED
  REMOVED
}

enum NewsJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  password String?

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  emailVerified           DateTime?
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  pendingEmail            String?   @unique

  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?

  name      String?
  bio       String? @db.Text
  avatarUrl String? @db.Text
  coverUrl  String? @db.Text
  isPrivate Boolean @default(false)
  isAdmin   Boolean @default(false)
  badgeType String?

  // ⚠️ Marks an account as an official ZRP editorial/automated feed
  // (ZRP News World, ZRP Travel, ...) rather than a person. Set only by
  // the admin-gated provisioning endpoint; never by signup. The UI uses
  // it to label these accounts as automated editorial feeds so they can
  // never be mistaken for a human user - see src/lib/news/feeds.ts.
  isEditorialFeed Boolean @default(false)

  category     String?
  showCategory Boolean @default(true)

  location          String?
  country           String?
  website           String?
  usernameChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role                Role    @default(USER)
  plan                String  @default("free")
  onboardingCompleted Boolean @default(false)
  banned              Boolean @default(false)

  publicLikes     Boolean @default(true)
  publicFollowing Boolean @default(true)

  customUrl String? @unique

  solanaWallet String?

  // ⚠️ SECURITY: cryptographically verified wallet ownership, used to
  // bind on-chain payments (tips, purchases) to the authenticated
  // account that actually controls the paying wallet - unlike
  // `solanaWallet` above, which is just an unverified payout address a
  // creator types into settings. Set only via the sign-a-nonce flow in
  // /api/wallet/link (see src/lib/wallet-link.ts).
  verifiedSolanaWallet  String?   @unique
  walletLinkNonce       String?
  walletLinkNonceExpiry DateTime?

  emailPreferences Json?

  pinnedPostId String? @unique
  pinnedPost   Post?   @relation("PinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)

  posts    Post[]
  comments Comment[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  likes     Like[]
  reposts   Repost[]
  reactions Reaction[]

  muter   Mute[] @relation("Muter")
  mutedBy Mute[] @relation("Muted")

  notifications     Notification[] @relation("Notification_user")
  sentNotifications Notification[] @relation("Notification_fromUser")

  fcmTokens FcmToken[]

  sentMessages     Message[] @relation("Message_sender")
  receivedMessages Message[] @relation("Message_receiver")

  messageReactions MessageReaction[]

  createdConversations     Conversation[]            @relation("Conversation_createdBy")
  conversationParticipants ConversationParticipant[]

  pollVotes PollVote[]
  bookmarks Bookmark[]

  pushSubscriptions PushSubscription[]

  stories    Story[]
  storyViews StoryView[]
  storyLikes StoryLike[]

  commentLikes     CommentLike[]
  commentReposts   CommentRepost[]
  commentBookmarks CommentBookmark[]

  upgradeRequests UpgradeRequest[]
  paymentRequests PaymentRequest[]

  blockedUsers Blocked[] @relation("Blocker")
  blockedBy    Blocked[] @relation("Blocked")

  reports          Report[] @relation("Reporter")
  reportsAgainstMe Report[] @relation("ReportTarget")
  appeals          Appeal[]

  listings         Listing[]         @relation("ListingSeller")
  listingFavorites ListingFavorite[]

  // ─── ZRP PLAY ──────────────────────────────────────────────
  playProfile          PlayProfile?
  playChallenges       PlayChallenge[]       @relation("PlayChallengeCreator")
  playAttempts         PlayAttempt[]
  playUserAchievements PlayUserAchievement[]
  duelsChallenged      PlayDuel[]            @relation("DuelChallenger")
  duelsReceived        PlayDuel[]            @relation("DuelOpponent")

  teamAccount TeamMember[] @relation("TeamAccount")
  teamMembers TeamMember[] @relation("TeamMemberUser")

  apiKeys ApiKey[]

  creatorProfile CreatorProfile?

  sentTips     Tip[] @relation("TipSender")
  receivedTips Tip[] @relation("TipRecipient")

  premiumPurchases PremiumPurchase[]

  withdrawalRequests WithdrawalRequest[]

  followRequestsSent     FollowRequest[] @relation("FollowRequester")
  followRequestsReceived FollowRequest[] @relation("FollowTarget")

  supportTickets  SupportTicket[]
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  ticketReplies   TicketReply[]

  aiConversations AIConversation[]
  aiDailyUsage    AIDailyUsage[]

  adCampaigns   AdCampaign[]   @relation("AdAdvertiser")
  adImpressions AdImpression[] @relation("AdImpressionUser")
  adClicks      AdClick[]      @relation("AdClickUser")

  newsArticles NewsArticle[] @relation("NewsAuthor")

  // ─── Journalist program ─────────────────────────────────────
  // A user's own journalist application/profile (present only if
  // they have ever applied to become a ZRP Journalist).
  journalistProfile JournalistProfile?

  // Journalist applications this user (an admin/moderator) has reviewed.
  journalistReviewsGiven JournalistProfile[] @relation("JournalistReviewedBy")

  // News articles this user (an admin/moderator) has reviewed
  // (approved/rejected) as part of the journalist submission workflow.
  newsReviewsGiven NewsArticle[] @relation("NewsReviewedBy")

  // ─── ZRP OPPORTUNITY ─────────────────────────────────────────
  opportunityListings     OpportunityListing[]      @relation("OpportunityPoster")
  opportunityApplications OpportunityApplication[]  @relation("OpportunityApplicant")
  opportunitySaved        OpportunitySavedListing[] @relation("OpportunitySaver")

  // ─── ZRP HELP ────────────────────────────────────────────────
  helpCampaigns          HelpCampaign[]          @relation("HelpOrganizer")
  helpContributions      HelpContribution[]      @relation("HelpContributor")
  helpOffers             HelpOffer[]             @relation("HelpOfferer")
  helpWithdrawalRequests HelpWithdrawalRequest[] @relation("HelpWithdrawalOrganizer")

  // ─── ZRP MUSIC ─────────────────────────────────────────────
  musicArtist    MusicArtist?
  musicPlaylists MusicPlaylist[]
  musicLikes     MusicLike[]
  musicFollows   MusicFollow[]
  musicHistory   MusicHistory[]

  // ─── ZRP NEWS NETWORK ──────────────────────────────────────
  newsFeed NewsFeed? @relation("EditorialFeedUser")
}

model JournalistProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status JournalistStatus @default(PENDING)

  // Application details supplied by the applicant.
  outlet       String? @db.Text
  pitch        String? @db.Text
  portfolioUrl String?

  appliedAt DateTime @default(now())

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("JournalistReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason  String? @db.Text
  suspensionReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewedById])
}

model Post {
  id        String   @id @default(cuid())
  content   String   @db.Text
  imageUrl  String?
  imageUrls String[] @default([])
  mediaType String?
  linkUrl   String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotePostId String?
  quotePost   Post?   @relation("QuotePost", fields: [quotePostId], references: [id], onDelete: SetNull)
  quotedBy    Post[]  @relation("QuotePost")

  views       Int       @default(0)
  scheduledAt DateTime?
  status      String    @default("published")

  hashtags String[]
  mentions String[]

  pollId String? @unique
  poll   Poll?   @relation(fields: [pollId], references: [id])
  isPoll Boolean @default(false)

  commentsEnabled Boolean @default(true)

  type     PostType @default(POST)
  company  String?
  location String?
  applyUrl String?
  body     String?  @db.Text

  pinnedBy User? @relation("PinnedPost")

  comments  Comment[]
  likes     Like[]
  reposts   Repost[]
  reactions Reaction[]

  notifications Notification[] @relation("Notification_post")

  reports   Report[]
  bookmarks Bookmark[]

  premiumPost PremiumPost?
  adCampaign  AdCampaign?

  // Set when this post was published by the ZRP News Network
  // automation, linking it back to its story, sources and rendition.
  newsPublication NewsPublication?

  @@index([createdAt])
  @@index([authorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([quotePostId])
  @@index([type])
}

model Comment {
  id       String  @id @default(cuid())
  content  String  @db.Text
  imageUrl String?

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  likes     CommentLike[]
  reposts   CommentRepost[]
  bookmarks CommentBookmark[]

  @@index([postId])
  @@index([createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FollowRequest {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("FollowRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  targetId String
  target   User   @relation("FollowTarget", fields: [targetId], references: [id], onDelete: Cascade)

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, targetId])
  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

model Like {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Repost {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  quoteContent String? @db.Text

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Reaction {
  id    String @id @default(cuid())
  emoji String

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@index([userId])
}

model Mute {
  id String @id @default(cuid())

  muterId String
  muter   User   @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)

  mutedId String
  muted   User   @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

// One row per device that has registered for native push (Firebase
// Cloud Messaging) - separate from PushSubscription above, which is
// browser Web Push (VAPID) and uses a completely different delivery
// mechanism. The token itself is what's unique (a re-login on the same
// device re-registers the same token under whichever account is
// signed in then, which is why registration is an upsert keyed on
// `token` rather than on `userId`). Sending from these tokens goes
// through src/lib/fcm.ts, using the Firebase service-account
// credential configured server-side (FIREBASE_SERVICE_ACCOUNT_JSON).
model FcmToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String @unique
  // "android" or "ios" - caller-supplied via POST /api/push/fcm, and
  // defaults to "android" for any request (or client build) that
  // doesn't send one, since that was the only platform this ever
  // supported until the iOS app existed.
  platform String @default("android")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("Notification_user", fields: [userId], references: [id], onDelete: Cascade)

  type String

  fromUserId String
  fromUser   User   @relation("Notification_fromUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation("Notification_post", fields: [postId], references: [id], onDelete: Cascade)

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@index([fromUserId])
}

model Message {
  id String @id @default(cuid())

  content  String  @db.Text
  imageUrl String?

  senderId String
  sender   User   @relation("Message_sender", fields: [senderId], references: [id], onDelete: Cascade)

  // Nullable, not removed: a real GROUP message has no single receiver
  // (see ConversationParticipant's own KDoc), so receiverId is null on
  // those rows going forward. Every EXISTING 1:1 message row already
  // has a real receiverId and keeps it - this relaxation only widens
  // what a NEW row is allowed to omit, it never touches existing data.
  // GET /messages/{userId}'s own 1:1 query (senderId/receiverId based)
  // is completely unaffected either way.
  receiverId String?
  receiver   User?   @relation("Message_receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // Null for every existing (and every future) 1:1 message - those
  // keep working through senderId/receiverId exactly as before. Set
  // only on a message sent inside a real GROUP (or, in principle, a
  // DIRECT) Conversation - see Conversation's own KDoc for why 1:1
  // history was deliberately NOT backfilled onto this column.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  read   Boolean @default(false)
  edited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  reactions MessageReaction[]

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([senderId, receiverId])
  @@index([replyToId])
  @@index([conversationId, createdAt])
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationParticipantRole {
  OWNER
  MEMBER
}

// A real GROUP conversation - deliberately NOT used to represent
// existing 1:1 messaging retroactively. Every 1:1 message already in
// this database (and every new one - see Message's own KDoc) keeps
// working through senderId/receiverId with zero Conversation row
// involved; backfilling one Conversation per historical DM pair was
// considered and rejected as unnecessary migration risk for no real
// benefit, since senderId/receiverId already fully identifies a DM
// pair. This model exists purely to give a GROUP conversation the
// participant list, name and read-state a plain sender/receiver pair
// structurally cannot express.
model Conversation {
  id   String           @id @default(cuid())
  type ConversationType

  // GROUP-only presentation - always null for the DIRECT value this
  // enum allows for future use, since a direct thread's name/avatar is
  // always derived from the other participant instead, matching how
  // 1:1 messaging already renders.
  name      String?
  avatarUrl String? @db.Text

  createdById String?
  createdBy   User?   @relation("Conversation_createdBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ConversationParticipantRole @default(MEMBER)

  joinedAt DateTime @default(now())

  // Per-participant read pointer, not a per-message Boolean fan-out:
  // a GROUP message's read state genuinely differs per participant, so
  // "unread" is computed server-side as messages in this conversation
  // newer than lastReadAt, the same efficient pattern real group-chat
  // products use instead of one row per (message, participant) pair.
  lastReadAt DateTime?

  // Removing a participant (kick, or leaving) deletes this row, which
  // is the actual authorization boundary every group message-read/
  // send/participant-list check queries against - it is never a soft
  // "active: false" flag to remember to filter on. Their past messages
  // stay in the conversation (Message.senderId is untouched), only
  // their own future access is revoked.
  @@unique([conversationId, userId])
  @@index([userId])
}

model MessageReaction {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji String

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model Poll {
  id String @id @default(cuid())

  question String   @db.Text
  options  String[]

  votes Json?

  post Post?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes_user PollVote[]
}

model PollVote {
  id String @id @default(cuid())

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  optionIndex Int

  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model Gif {
  id String @id @default(cuid())

  url    String
  title  String?
  width  Int?
  height Int?

  createdAt DateTime @default(now())
}

model Blocked {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // SetNull rather than Cascade: a moderation action that deletes the
  // reported post/comment must NOT also delete the Report row recording
  // why - that would erase the moderation-transparency audit trail (and
  // any appeal referencing it) at the exact moment the action it
  // describes is carried out.
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  reason  String
  details String? @db.Text

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionType String?
  actionNote String?   @db.Text
  actionedAt DateTime?

  // Denormalized at the moment an action is taken (see PUT
  // /api/admin/reports/[id]): the post/comment author may become
  // unreachable later (content deleted, SetNull above), but the person
  // an action was actually taken against must still be identifiable so
  // they can be shown - and file - an appeal.
  targetUserId String?
  targetUser   User?   @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Third optional polymorphic target, same pattern as postId/commentId
  // above - reuses this entire reporting/moderation/appeals/transparency
  // system for marketplace listings instead of building a parallel one.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  // Fourth polymorphic target, same pattern again - reuses the same
  // reporting/moderation system for ZRP PLAY user-created challenges.
  challengeId String?
  challenge   PlayChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  // Fifth polymorphic target - ZRP OPPORTUNITY listings.
  opportunityId String?
  opportunity   OpportunityListing? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  // Sixth polymorphic target - ZRP HELP campaigns.
  campaignId String?
  campaign   HelpCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  appeals Appeal[]

  @@index([postId])
  @@index([commentId])
  @@index([listingId])
  @@index([challengeId])
  @@index([opportunityId])
  @@index([campaignId])
  @@index([status])
  @@index([reporterId])
  @@index([targetUserId])
}

model Appeal {
  id String @id @default(cuid())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String @db.Text

  status String @default("pending") // pending | upheld | overturned

  resolutionNote     String?   @db.Text
  resolvedById       String?
  resolvedByUsername String?
  resolvedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One appeal per user per actioned report - resubmission isn't how
  // this is meant to work; a denied appeal is final unless staff reopen
  // the underlying report.
  @@unique([reportId, userId])
  @@index([userId])
  @@index([status])
}

