generator client {
  provider = "prisma-client-js"
}

// ⚠️ Prisma 7+: the connection URL no longer lives here - it moved to
// prisma.config.ts (for the CLI: generate/migrate/studio) and to the
// PrismaPg driver adapter passed into `new PrismaClient({ adapter })`
// in src/lib/db.ts (for the running app). Prisma 7 rejects a `url` on
// this block outright (P1012) - see https://pris.ly/d/config-datasource.
datasource db {
  provider = "postgresql"
}

// ─── Advanced Search trigram indexes ────────────────────────────────
// Migration 20260928120000_add_search_trigram_indexes adds pg_trgm +
// GIN(gin_trgm_ops) indexes on User.username/name/headline/company,
// Post.content, Community.name/description, MusicArtist.displayName,
// MusicAlbum.title, MusicTrack.title, MusicPlaylist.name,
// OpportunityListing.title/description, Listing.title/description, and
// NewsArticle.title/excerpt (plus a plain GIN index on Post.hashtags
// and OpportunityListing.skills for array-containment filters). These
// are hand-authored raw SQL, not `@@index` here: expressing a non-
// default operator class requires the `postgresqlExtensions`/
// `extendedIndexes` preview features, which this schema deliberately
// doesn't enable (see the Prisma 7+ note above on staying
// conservative). See that migration file for the full rationale.

enum Role {
  USER
  MODERATOR
  ADMIN
  JOURNALIST
}

enum JournalistStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AmbassadorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Progression is driven by real community activity once that data
// exists (see AmbassadorProfile below) - not by simply applying or
// creating an account. Every profile starts at EXPLORER regardless of
// status; APPROVED only unlocks the AMBASSADOR level and up.
enum AmbassadorLevel {
  EXPLORER
  AMBASSADOR
  COMMUNITY_LEADER
  GLOBAL_AMBASSADOR
}

enum PostType {
  POST
  RECRUITMENT
  ARTICLE
}

enum TeamRole {
  ADMIN
  EDITOR
  VIEWER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TokenVenue {
  DIRECT_MINT
  PUMP_CURVE
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

// Lifecycle of a global announcement broadcast. DRAFT/SCHEDULED are the
// only states a SEND request may transition out of (atomically, to
// SENDING) - see src/lib/announcements/dispatch.ts. SENDING is itself
// the idempotency guard: a second concurrent send request, or a
// double-click, can never start a duplicate broadcast because the
// conditional UPDATE that performs the transition only ever matches
// one row once.
enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  // Finished, but at least one batch recorded a processing-level error
  // (e.g. a transient database failure writing that batch's
  // Notification rows) - NOT the same thing as an individual invalid
  // push token, which sendPushNotification already absorbs silently
  // and never surfaces here. See dispatch.ts.
  PARTIAL
  // Every batch failed - distinct from PARTIAL (which means SOME
  // recipients were reached).
  FAILED
  CANCELLED
}

enum TicketCategory {
  GENERAL
  ACCOUNT
  PRIVACY
  CONTENT
  MODERATION
  PAYMENT
  MONETISATION
  BUG
  FEATURE_REQUEST
  SECURITY
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_REPLY
  RESOLVED
  CLOSED
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  // Content approved by staff, awaiting the advertiser's budget payment -
  // a campaign never goes straight from review to serving without one.
  PAYMENT_PENDING
  // The submitted transaction failed verification; the advertiser can
  // retry payment from this state (see POST /api/ads/campaigns/[id]/pay).
  PAYMENT_FAILED
  ACTIVE
  PAUSED
  // Staff-forced stop on an otherwise-active campaign (policy violation
  // found after going live) - distinct from the advertiser's own PAUSED,
  // which only staff can lift again via resume.
  SUSPENDED
  // Advertiser- or staff-initiated permanent stop, distinct from
  // COMPLETED (which means the campaign ran its course/exhausted budget).
  CANCELLED
  COMPLETED
  REJECTED
}

enum AdBidType {
  CPC
  CPM
}

