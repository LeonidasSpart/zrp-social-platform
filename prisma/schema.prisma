  // Set when this post was published by the ZRP News Network
  // automation, linking it back to its story, sources and rendition.
  newsPublication NewsPublication?

  // ─── ZRP Discover ────────────────────────────────────────────
  discoverEvents     DiscoverEvent[]
  discoverDismissals DiscoverDismissal[]

  @@index([createdAt])
  @@index([authorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([quotePostId])
