// How well corroborated a story is. Never inferred optimistically: a
// story only reaches CONFIRMED when independent sources of sufficient
// trust agree, and the label is rendered verbatim in the published post
// so a developing story is never presented as settled fact.
enum NewsConfidence {
  CONFIRMED
  DEVELOPING
  UNCONFIRMED
}

enum NewsRenditionStatus {
  PENDING
  READY
  FAILED
  REJECTED
}

enum NewsPublicationStatus {
  SCHEDULED
  PUBLISHED
  FAILED
  REMOVED
}

enum NewsJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  password String?

  // ⚠️ SECURITY: bumped on every password change (see PUT
  // /api/user/password) and baked into every JWT/session token at
  // mint/refresh time (src/lib/auth.ts, src/app/api/mobile/auth/*) -
  // applyAuthStateToToken() (src/lib/auth-state.ts) treats a token
  // whose version no longer matches the database's current value
  // exactly like a banned session, forcing an immediate sign-out.
  // Without this, changing a password never invalidated any other
  // already-issued session/token - a stolen cookie or leaked native
  // sessionToken stayed valid for up to 30 days even after the
  // legitimate user "secured" the account.
  credentialsVersion Int @default(0)

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  emailVerified           DateTime?
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  pendingEmail            String?   @unique

  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?

  name      String?
  bio       String? @db.Text
  avatarUrl String? @db.Text
  coverUrl  String? @db.Text
  isPrivate Boolean @default(false)
  isAdmin   Boolean @default(false)
  badgeType String?

  // ⚠️ Marks an account as an official ZRP editorial/automated feed
  // (ZRP News World, ZRP Travel, ...) rather than a person. Set only by
  // the admin-gated provisioning endpoint; never by signup. The UI uses
  // it to label these accounts as automated editorial feeds so they can
  // never be mistaken for a human user - see src/lib/news/feeds.ts.
  isEditorialFeed Boolean @default(false)

  category     String?
  showCategory Boolean @default(true)

  location          String?
  country           String?
  website           String?
  usernameChangedAt DateTime?

  // ⚠️ Normalized ISO 3166-1 alpha-2 mirror of the free-text `country`
  // above, derived via src/lib/geo/country.ts every time `country` is
  // written (PUT /api/user). `country` stays free text for display/
  // back-compat with existing profiles; every query that needs to
  // compare countries (analytics, ad targeting, feed ranking, "people
  // near you") must use `countryCode`, never `country` - a free-text
  // "Switzerland"/"Suisse"/"Schweiz"/"CH" would otherwise never match
  // each other. Null until the user's country is set/re-saved once
  // this field exists (existing rows need the backfill script in
  // scripts/backfill-country-codes.ts).
  countryCode String?

  // ─── Immutable signup snapshot (Phase 6: historical integrity) ─────
  // Set exactly once, in POST /api/auth/register, and never touched by
  // any other route - so a later profile country change (e.g. someone
  // relocates from Switzerland to France) never rewrites the history of
  // where signups actually came from. `createdAt` above already serves
  // as the immutable signup timestamp; these fields are its geographic/
  // acquisition counterparts. See docs/user-geography-and-acquisition.md.
  //
  // signupCountryCode: derived from the registering request's IP via a
  // local (no external network call, no raw-IP retention) lookup in
  // src/lib/geo/ip-lookup.ts - the raw IP itself is never persisted
  // here, only the resolved two-letter code. Null when resolution
  // fails (e.g. localhost/private-range IP in dev) - never guessed.
  signupCountryCode String?

  // signupSource: DIRECT (no ref/utm param present at registration) |
  // REFERRAL (a `ref` param matched a real AmbassadorProfile
  // invitationCode) | CAMPAIGN (a utm_source/utm_campaign param was
  // present) | UNKNOWN. Never "ORGANIC" - see the module doc on
  // src/app/api/auth/register/route.ts for why that distinction isn't
  // measurable today and is never guessed.
  //
  // The DB default below is deliberately "UNKNOWN", not "DIRECT": it
  // only ever applies to rows created before this column existed, whose
  // real acquisition source is genuinely unknown - defaulting them to
  // DIRECT would fabricate history that was never observed. Every row
  // created through POST /api/auth/register from here on always sets
  // this explicitly (DIRECT/REFERRAL/CAMPAIGN), never relying on the
  // column default.
  signupSource String @default("UNKNOWN")

  // Raw utm_source/utm_campaign or ambassador invitationCode value that
  // produced the signupSource above, kept for admin drill-down. Null
  // when signupSource is DIRECT or UNKNOWN.
  signupCampaign String?

  // "web" | "android" | "ios" | "UNKNOWN", read from the new
  // X-Zrp-Platform header native clients send (absent => "web").
  // Immutable once set. Same reasoning as signupSource above: the
  // column default is "UNKNOWN" so pre-migration rows aren't
  // fabricated as "web"; every new registration sets this explicitly.
  signupPlatform String @default("UNKNOWN")

  // ─── Language (mutable) ─────────────────────────────────────────
  // Synced from the client's chosen UI language (the same value already
  // held client-side in the `zrp-lang` cookie / LanguageContext) via
  // PUT /api/user and captured once at registration from that cookie
  // when present. Unlike signup* above this is NOT immutable - it
  // reflects the user's current language preference, for admin
  // analytics and (future) language-aware ranking.
  languageCode String?

  // ─── Professional profile (Phase 12/14) ─────────────────────────
  // `category` (existing field, see src/lib/professionalCategories.ts)
  // already serves as the industry taxonomy - deliberately not
  // duplicated here. These four are the genuinely missing fields.
  headline String?  @db.Text
  company  String?
  position String?
  skills   String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role                Role    @default(USER)
  plan                String  @default("free")
  onboardingCompleted Boolean @default(false)
  banned              Boolean @default(false)

  publicLikes     Boolean @default(true)
  publicFollowing Boolean @default(true)

  customUrl String? @unique

  solanaWallet String?

  // ⚠️ SECURITY: cryptographically verified wallet ownership, used to
  // bind on-chain payments (tips, purchases) to the authenticated
  // account that actually controls the paying wallet - unlike
  // `solanaWallet` above, which is just an unverified payout address a
  // creator types into settings. Set only via the sign-a-nonce flow in
  // /api/wallet/link (see src/lib/wallet-link.ts).
  verifiedSolanaWallet  String?   @unique
  walletLinkNonce       String?
  walletLinkNonceExpiry DateTime?

  emailPreferences Json?

  pinnedPostId String? @unique
  pinnedPost   Post?   @relation("PinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)

  posts    Post[]
  comments Comment[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  likes     Like[]
  reposts   Repost[]
  reactions Reaction[]

  muter   Mute[] @relation("Muter")
  mutedBy Mute[] @relation("Muted")

  // "Notify me when this account posts" - see PostSubscription below.
  // Named to match Follow's own naming shape (subscriber/author, not
  // Mute's muter/muted) since this is a directional "get notified about
  // X's posts" relationship, not a mutual/symmetric one.
  postSubscriptionsGiven  PostSubscription[] @relation("PostSubscriptionSubscriber")
  postSubscriptionsGained PostSubscription[] @relation("PostSubscriptionAuthor")

  notifications     Notification[] @relation("Notification_user")
  sentNotifications Notification[] @relation("Notification_fromUser")

  fcmTokens  FcmToken[]
  voipTokens VoipToken[]

  sentMessages     Message[] @relation("Message_sender")
  receivedMessages Message[] @relation("Message_receiver")

  messageReactions MessageReaction[]

  createdConversations     Conversation[]            @relation("Conversation_createdBy")
  conversationParticipants ConversationParticipant[]

  pollVotes PollVote[]
  bookmarks Bookmark[]

  pushSubscriptions PushSubscription[]

  stories    Story[]
  storyViews StoryView[]
  storyLikes StoryLike[]

  commentLikes     CommentLike[]
  commentReposts   CommentRepost[]
  commentBookmarks CommentBookmark[]

  upgradeRequests UpgradeRequest[]
  paymentRequests PaymentRequest[]
  subscription    Subscription?

  blockedUsers Blocked[] @relation("Blocker")
  blockedBy    Blocked[] @relation("Blocked")

  conversationClearances     ConversationClearance[] @relation("ConversationClearanceUser")
  conversationClearancesOfMe ConversationClearance[] @relation("ConversationClearanceOtherUser")

  reports                 Report[] @relation("Reporter")
  reportsAgainstMe        Report[] @relation("ReportTarget")
  profileReportsAgainstMe Report[] @relation("ReportedUser")
  appeals                 Appeal[]

  listings         Listing[]         @relation("ListingSeller")
  listingFavorites ListingFavorite[]

  // ─── ZRP PLAY ──────────────────────────────────────────────
  playProfile          PlayProfile?
  playChallenges       PlayChallenge[]       @relation("PlayChallengeCreator")
  playAttempts         PlayAttempt[]
  playUserAchievements PlayUserAchievement[]
  duelsChallenged      PlayDuel[]            @relation("DuelChallenger")
  duelsReceived        PlayDuel[]            @relation("DuelOpponent")

  teamAccount TeamMember[] @relation("TeamAccount")
  teamMembers TeamMember[] @relation("TeamMemberUser")

  apiKeys ApiKey[]

  creatorProfile CreatorProfile?

  sentTips     Tip[] @relation("TipSender")
  receivedTips Tip[] @relation("TipRecipient")

  premiumPurchases PremiumPurchase[]

  withdrawalRequests WithdrawalRequest[]

  launchedTokens LaunchedToken[]
  vestingContracts VestingContract[]
  stakingPools StakingPool[]
  launchedNfts LaunchedNft[]
  nftStakingPools NftStakingPool[] @relation("NftStakingPoolCreator")
  farmingPools FarmingPool[]
  daos Dao[]
  idoCampaigns IdoCampaign[]
  airdrops Airdrop[]
  tokenPoolsCreated TokenPool[]

  followRequestsSent     FollowRequest[] @relation("FollowRequester")
  followRequestsReceived FollowRequest[] @relation("FollowTarget")

  supportTickets  SupportTicket[]
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  ticketReplies   TicketReply[]

  aiConversations  AIConversation[]
  aiDailyUsage     AIDailyUsage[]
  repostDailyUsage RepostDailyUsage[]

  adCampaigns   AdCampaign[]   @relation("AdAdvertiser")
  adImpressions AdImpression[] @relation("AdImpressionUser")
  adClicks      AdClick[]      @relation("AdClickUser")

  newsArticles NewsArticle[] @relation("NewsAuthor")

  // ─── Journalist program ─────────────────────────────────────
  // A user's own journalist application/profile (present only if
  // they have ever applied to become a ZRP Journalist).
  journalistProfile JournalistProfile?

  // Journalist applications this user (an admin/moderator) has reviewed.
  journalistReviewsGiven JournalistProfile[] @relation("JournalistReviewedBy")

  // News articles this user (an admin/moderator) has reviewed
  // (approved/rejected) as part of the journalist submission workflow.
  newsReviewsGiven NewsArticle[] @relation("NewsReviewedBy")

  // ─── ZRP Global Ambassadors ─────────────────────────────────
  // A user's own ambassador application/profile (present only if
  // they have ever applied), same one-model-covers-application-and-
  // profile shape as journalistProfile above.
  ambassadorProfile AmbassadorProfile?

  // Ambassador applications this user (an admin/moderator) has reviewed.
  ambassadorReviewsGiven AmbassadorProfile[] @relation("AmbassadorReviewedBy")

  // Present only if this user signed up via an ambassador's invitation
  // link - see the Referral model.
  referredBy Referral? @relation("ReferralReferredUser")

  // ─── ZRP OPPORTUNITY ─────────────────────────────────────────
  opportunityListings     OpportunityListing[]      @relation("OpportunityPoster")
  opportunityApplications OpportunityApplication[]  @relation("OpportunityApplicant")
  opportunitySaved        OpportunitySavedListing[] @relation("OpportunitySaver")

  // ─── ZRP HELP ────────────────────────────────────────────────
  helpCampaigns          HelpCampaign[]          @relation("HelpOrganizer")
  helpContributions      HelpContribution[]      @relation("HelpContributor")
  helpOffers             HelpOffer[]             @relation("HelpOfferer")
  helpWithdrawalRequests HelpWithdrawalRequest[] @relation("HelpWithdrawalOrganizer")

  // ─── ZRP MUSIC ─────────────────────────────────────────────
  musicArtist    MusicArtist?
  musicPlaylists MusicPlaylist[]
  musicLikes     MusicLike[]
  musicFollows   MusicFollow[]
  musicHistory   MusicHistory[]

  // ─── ZRP NEWS NETWORK ──────────────────────────────────────
  newsFeed NewsFeed? @relation("EditorialFeedUser")

  // ─── ZRP Communities ─────────────────────────────────────────
  communitiesCreated   Community[]       @relation("CommunityCreator")
  communityMemberships CommunityMember[] @relation("CommunityMemberUser")

  // ─── ZRP Lists ───────────────────────────────────────────────
  ownedLists      List[]       @relation("ListOwner")
  listMemberships ListMember[] @relation("ListMemberUser")

  // ─── ZRP Discover ────────────────────────────────────────────
  discoverEvents     DiscoverEvent[]     @relation("DiscoverEventUser")
  discoverDismissals DiscoverDismissal[]

  // ─── ZRP Live Audio ──────────────────────────────────────────
  liveAudioRoomsHosted                LiveAudioRoom[]             @relation("LiveAudioHost")
  liveAudioParticipations             LiveAudioParticipant[]      @relation("LiveAudioParticipantUser")
  liveAudioParticipantsRemoved        LiveAudioParticipant[]      @relation("LiveAudioParticipantRemovedBy")
  liveAudioSpeakerRequests            LiveAudioSpeakerRequest[]   @relation("LiveAudioSpeakerRequestUser")
  liveAudioSpeakerRequestsResolved    LiveAudioSpeakerRequest[]   @relation("LiveAudioSpeakerRequestResolvedBy")
  liveAudioModerationActionsPerformed LiveAudioModerationAction[] @relation("LiveAudioModerationActor")
  liveAudioModerationActionsReceived  LiveAudioModerationAction[] @relation("LiveAudioModerationTarget")

  // ─── ZRP Live Video ──────────────────────────────────────────
  liveVideoRoomsHosted                LiveVideoRoom[]             @relation("LiveVideoHost")
  liveVideoParticipations             LiveVideoParticipant[]      @relation("LiveVideoParticipantUser")
  liveVideoParticipantsRemoved        LiveVideoParticipant[]      @relation("LiveVideoParticipantRemovedBy")
  liveVideoSpeakerRequests            LiveVideoSpeakerRequest[]   @relation("LiveVideoSpeakerRequestUser")
  liveVideoSpeakerRequestsResolved    LiveVideoSpeakerRequest[]   @relation("LiveVideoSpeakerRequestResolvedBy")
  liveVideoModerationActionsPerformed LiveVideoModerationAction[] @relation("LiveVideoModerationActor")
  liveVideoModerationActionsReceived  LiveVideoModerationAction[] @relation("LiveVideoModerationTarget")

  // Admin Subscriptions & Billing (list/KPI queries filter and group by
  // plan directly on User, since a legacy-paid user may have no
  // Subscription row yet - see docs/subscriptions.md "Legacy users").
  @@index([plan])
  // Geography/acquisition analytics + feed geo-relevance + ad targeting
  // all groupBy/filter on these - see docs/user-geography-and-acquisition.md.
  @@index([countryCode])
  @@index([signupCountryCode])
  @@index([signupSource])
  @@index([signupPlatform])
  @@index([languageCode])
}

model JournalistProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status JournalistStatus @default(PENDING)

  // Application details supplied by the applicant.
  outlet       String? @db.Text
  pitch        String? @db.Text
  portfolioUrl String?

  appliedAt DateTime @default(now())

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("JournalistReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason  String? @db.Text
  suspensionReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewedById])
}

// ZRP Global Ambassadors. One model covers both the application and
// the ongoing profile, same shape as JournalistProfile above - a
// PENDING application becomes the profile itself once APPROVED,
// rather than living in a separate table that would need to be kept
// in sync with it.
model AmbassadorProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status AmbassadorStatus @default(PENDING)
  level  AmbassadorLevel  @default(EXPLORER)

  // ISO 3166-1 alpha-2, validated server-side against the canonical
  // dataset in src/lib/ambassadors/countries.ts on every write - this
  // is the stable identifier the world map, country stats and the
  // explorer all key off.
  countryCode String
  cityRegion  String? @db.Text

  languages            String[] @default([])
  communityLinks       String[] @default([]) // https:// URLs only, validated on write
  motivation           String   @db.Text
  communityDescription String?  @db.Text
  audienceSize         Int? // approximate, self-reported at application time

  // Stable per-profile referral identifier for "My Invitation Link" on
  // the dashboard. Points signups at /signup?ref=<code> today; nothing
  // downstream credits a signup back to the referring ambassador yet -
  // there is no referral/invite system elsewhere in ZRP to hook into,
  // and building one is outside this feature's scope (see the PR).
  invitationCode String @unique @default(cuid())

  appliedAt DateTime @default(now())

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("AmbassadorReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason  String? @db.Text
  suspensionReason String? @db.Text

  // Server-authoritative acceptance of the Ambassador Code of Conduct
  // (ZRP Community & Leadership Code, section B) - set once at
  // application time and re-set whenever the applicant/ambassador
  // accepts a newer version after CURRENT_CODE_OF_CONDUCT_VERSION
  // (src/lib/ambassadors/codeOfConduct.ts) changes. Never trust a
  // client-only "accepted" flag: acceptedAt is stamped server-side by
  // the API route at the moment of acceptance, not supplied by the client.
  codeOfConductVersion    String?
  codeOfConductAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals Referral[]

  @@index([status])
  @@index([countryCode])
  @@index([reviewedById])
}

// Launchpad affiliate/referral program: credits an APPROVED ambassador a
// commission when someone who signed up through their /signup?ref=<code>
// link goes on to pay a real ZRP launchpad fee. Attribution (this row) is
// permanent and first-touch, recorded once at signup regardless of the
// ambassador's review status at the time; whether it currently EARNS
// commission is re-checked at every fee event (see
// src/lib/referral.ts:creditReferralCommission), so a since-suspended
// ambassador's existing referrals stop paying out without needing any
// retroactive cleanup here.
model Referral {
  id String @id @default(cuid())

  ambassadorProfileId String
  ambassadorProfile   AmbassadorProfile @relation(fields: [ambassadorProfileId], references: [id], onDelete: Cascade)

  // One attribution per referred account, ever - the unique constraint is
  // what makes this first-touch (a second ambassador's ref link on an
  // already-attributed signup is simply not recorded).
  referredUserId String @unique
  referredUser   User   @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  commissions ReferralCommission[]

  @@index([ambassadorProfileId])
}

enum ReferralCommissionSource {
  LAUNCHPAD_TOKEN_CREATION
}

// One row per commission-earning event. Unique on (sourceType, sourceId)
// so the same fee event (e.g. one LaunchedToken) can never be credited
// twice, even if the caller is retried - the same idempotency shape as
// LaunchedToken.feeTransactionId/mintTransactionId elsewhere in this file.
model ReferralCommission {
  id String @id @default(cuid())

  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  sourceType ReferralCommissionSource
  sourceId   String

  feeAmount        Decimal @db.Decimal(18, 6)
  commissionAmount Decimal @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  @@unique([sourceType, sourceId])
  @@index([referralId])
}

model Post {
  id        String   @id @default(cuid())
