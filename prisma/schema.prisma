  @@index([creatorProfileId])
}

// ZRP Launchpad, phase 1: SPL token creation. The on-chain mint
// transaction is server-signed (platform Keypair, same one
// sendUsdc()/withdrawals already use) rather than signed in-browser by
// the creator's own wallet - mint/freeze/update authorities are
// assigned directly to the creator's User.verifiedSolanaWallet at
// creation time (or revoked outright), which needs no signature from
// that wallet at all, so this never reintroduces the in-browser
// wallet-connect/sign dependency tree this codebase deliberately
// removed (see TipModal.tsx's own comment on that). mintAddress and
// mintTransactionId both start null and are filled in exactly once,
// as early as possible after each is known, matching
// withdrawals.ts's crash-safety pattern (record the signature before
// waiting on confirmation, not after).
model LaunchedToken {
  id String @id @default(cuid())

  mintAddress String? @unique

  // DIRECT_MINT (default): ZRP's own atomic client-signed SPL mint, a
  // flat USDC fee charged and recorded below. PUMP_CURVE: created through
  // pump.fun's real bonding-curve program (create_v2/create_v2_and_buy,
  // see client-pump-create.ts) - ZRP charges no separate fee for this
  // path (pump.fun's own protocol fees apply on every curve trade
  // instead), so feeAmount/feeTransactionId are null for these rows.
  venue TokenVenue @default(DIRECT_MINT)

  name        String
  symbol      String
  description String? @db.Text
  imageUrl    String

  website  String?
  twitter  String?
  telegram String?
  discord  String?

  supply   Decimal @db.Decimal(38, 0)
  decimals Int

  revokeMint   Boolean @default(false)
  revokeFreeze Boolean @default(false)
  revokeUpdate Boolean @default(false)

  feeAmount        Decimal? @db.Decimal(18, 6)
  feeTransactionId String?  @unique

  mintTransactionId String? @unique

  status        TransactionStatus @default(PENDING)
  failureReason String?

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])

  vestingContracts VestingContract[]
  stakingPools     StakingPool[]
  nftStakingPoolsAsReward NftStakingPool[]
  farmingPoolsAsReward FarmingPool[]
  dao Dao?
  idoCampaigns IdoCampaign[]
  airdrops Airdrop[]
  pools TokenPool[]
}

enum VestingContractStatus {
  ACTIVE
  COMPLETED
}

// ZRP Launchpad, phase 2: linear (+ optional cliff) vesting against an
// already-launched token. Deliberately NOT tied to a ZRP account on the
// beneficiary side - vesting recipients (team, advisors, investors) are
// routinely people who never sign up for the platform at all, only a
// wallet address. Two independent, already-proven-safe patterns cover
// both directions of money movement, so nothing new had to be invented:
//   - deposit (creator -> platform escrow): "pay externally, paste the
//     tx signature" - identical in shape to every other payment-in flow
//     in this codebase (tip, premium purchase, launchpad creation fee),
//     verified by src/lib/launchpad/spl-transfer-verify.ts (the
//     LaunchedToken-mint-aware generalization of verifyUsdcTransaction).
//   - claim (platform -> beneficiary, server-signed): authorized by an
//     ed25519 signature over a single-use, server-issued challenge
//     proving ownership of beneficiaryWalletAddress - the exact same
//     primitive src/lib/wallet-link.ts already uses for linking a
//     wallet to an account (buildWalletLinkMessage/verifyWalletSignature
//     are reused as-is; they were never account-specific internally).
//     No ZRP session is required to claim.
// All amounts are raw base units (matching LaunchedToken.supply), never
// floating point, so vesting math can never lose precision the way
// zrppad's own float-based getClaimableAmount() did.
model VestingContract {
  id String @id @default(cuid())

  launchedTokenId String
  launchedToken   LaunchedToken @relation(fields: [launchedTokenId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  beneficiaryWalletAddress String

  totalAmount   Decimal @db.Decimal(38, 0)
  totalReleased Decimal @db.Decimal(38, 0) @default(0)

  cliffSeconds   Int
  vestingSeconds Int
  startAt        DateTime

  depositTransactionId String @unique

  status VestingContractStatus @default(ACTIVE)

  // Single-use claim challenge (see the model comment above). Cleared
  // (set back to null) the instant it's consumed by a claim, whether
  // that claim succeeds or finds nothing claimable - a stale nonce is
  // never left around to be reused.
  claimNonce          String?
  claimNonceExpiresAt DateTime?

  // Set when a claim's on-chain outcome couldn't be confirmed (e.g. an
  // RPC timeout after the transfer was already broadcast) - the payout
  // may have genuinely succeeded. While set, no further claim-challenge
  // can be issued, so a second claim can never be attempted against a
  // payout whose real outcome is unknown. Cleared only by an operator
  // after manually verifying disputedTransactionId on-chain (see
  // executeVestingClaim's own comment on this class of failure).
  disputedTransactionId String?
  disputedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  releases VestingRelease[]

  @@index([launchedTokenId])
  @@index([beneficiaryWalletAddress])
  @@index([status])
}

model VestingRelease {
  id String @id @default(cuid())

  vestingContractId String
  vestingContract   VestingContract @relation(fields: [vestingContractId], references: [id], onDelete: Cascade)

  amount        Decimal @db.Decimal(38, 0)
  transactionId String  @unique

  createdAt DateTime @default(now())

  @@index([vestingContractId])
}

enum StakingPositionStatus {
  ACTIVE
  UNSTAKED
}

// ZRP Launchpad, phase 3: fixed-APY staking pools against an
// already-launched token. Fully wallet-native like VestingContract's
// beneficiary side - opening or closing a position needs no ZRP
// account, only the wallet itself:
//   - stake (user -> platform escrow): "pay externally, paste the tx
//     signature" exactly like a vesting deposit. The verified on-chain
//     sender IS the position's owner - result.from === the wallet
//     address the caller claims to stake for is the only check needed,
//     since nobody but the true key-holder could have produced that
//     transfer.
//   - claim rewards / unstake (platform -> user, server-signed):
//     the SAME single-use ed25519 challenge pattern as a vesting claim
//     (buildWalletLinkMessage/verifyWalletSignature, bound to the
//     position id), via claimNonce/claimNonceExpiresAt below.
// Rewards are backed by a real, explicitly funded reserve
// (StakingRewardDeposit, same pay-externally pattern) rather than
// zrppad's pools, which could promise an APY with nothing behind it -
// rewardReserveRaw is decremented atomically on every payout (the same
// "reserve atomically, never check-then-increment" rule
// src/lib/ai-quota.ts established), so a claim can never pay out more
// than the pool has actually been funded with.
model StakingPool {
  id String @id @default(cuid())

  launchedTokenId String
  launchedToken   LaunchedToken @relation(fields: [launchedTokenId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  // Annual percentage yield in basis points (1000 = 10.00%) - never a
  // float, so reward math can be done entirely in BigInt.
  apyBasisPoints Int
  lockSeconds    Int
  minStakeRaw    Decimal  @db.Decimal(38, 0)
  maxStakeRaw    Decimal? @db.Decimal(38, 0)

  totalStakedRaw    Decimal @db.Decimal(38, 0) @default(0)
  rewardReserveRaw  Decimal @db.Decimal(38, 0) @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions      StakingPosition[]
  rewardDeposits StakingRewardDeposit[]

  @@index([launchedTokenId])
  @@index([creatorId])
}

model StakingPosition {
  id String @id @default(cuid())

