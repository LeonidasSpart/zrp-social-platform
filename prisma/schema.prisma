  createdAt DateTime @default(now())

  @@index([poolId])
}

// ZRP Launchpad, phase 6a: NFT creation. A near-identical sibling of
// LaunchedToken - server-signed mint, platform briefly holds authority
// before handing it off to the creator's verified wallet, same "pay
// externally, paste the signature" fee flow - but always supply=1,
// decimals=0, plus a Metaplex Master Edition account (see
// mint-service.ts's mintLaunchedNft()) so wallets/marketplaces
// recognise it as a true non-fungible, not just a token that happens to
// have one unit. `collectionName` is a free-text grouping the creator
// chooses (shown on the browse page, and what an NftStakingPool below
// is opened against) - deliberately NOT an on-chain Metaplex Certified
// Collection (a separate Collection NFT + on-chain Verify instruction);
// that trust is kept server-side instead, same posture as the rest of
// this already-server-trusted launchpad, and it means zero extra
// on-chain accounts or instructions for v1.
model LaunchedNft {
  id String @id @default(cuid())

  mintAddress String? @unique

  name        String
  description String? @db.Text
  imageUrl    String

  collectionName String?

  // Metaplex off-chain trait array: [{ trait_type, value }, ...] - served
  // as-is inside GET /api/launchpad/nfts/[mint]/metadata.json.
  attributes Json?

  sellerFeeBasisPoints Int @default(0)

  revokeUpdate Boolean @default(false)

  feeAmount        Decimal @db.Decimal(18, 6)
  feeTransactionId String  @unique

  mintTransactionId String? @unique

  status        TransactionStatus @default(PENDING)
  failureReason String?

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stakingPositions NftStakingPosition[]

  @@index([creatorId])
  @@index([status])
  @@index([collectionName])
}

enum NftStakingPositionStatus {
  ACTIVE
  UNSTAKED
}

// ZRP Launchpad, phase 6b: NFT staking. An NFT is just an SPL mint with
// supply=1/decimals=0, so "stake" and "unstake" reuse the exact same
// wallet-native primitives as fungible staking unchanged:
//   - stake (user -> platform escrow): "pay externally, paste the tx
//     signature", verified by the same mint-agnostic
//     verifySplTransferToPlatform() - the expected mint is just this
//     NFT's own mintAddress and the expected amount is always 1.
//   - claim / unstake (platform -> user, server-signed): the same
//     single-use ed25519 challenge pattern as a fungible staking claim.
// What's genuinely different: a non-fungible position has no "amount"
// to apply an APY to, so rewards accrue at a flat
// rewardRatePerDayRaw per staked NFT, paid out in a SEPARATE fungible
// LaunchedToken (rewardToken) rather than the NFT's own mint - and
// unstaking returns the NFT itself (1 raw unit of ITS mint) as a
// second, independent payout alongside the reward token payout.
// Same funded-reserve safety as StakingPool.rewardReserveRaw: a claim
// can never pay out more than this pool has actually been funded with.
model NftStakingPool {
  id String @id @default(cuid())

  collectionName String
  creatorId      String
  creator        User   @relation("NftStakingPoolCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  rewardTokenId String
  rewardToken   LaunchedToken @relation(fields: [rewardTokenId], references: [id], onDelete: Cascade)

  rewardRatePerDayRaw Decimal @db.Decimal(38, 0)
  lockSeconds         Int

  rewardReserveRaw Decimal @db.Decimal(38, 0) @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions      NftStakingPosition[]
  rewardDeposits NftStakingRewardDeposit[]

  @@index([creatorId])
  @@index([collectionName])
}

model NftStakingPosition {
  id String @id @default(cuid())

  poolId String
  pool   NftStakingPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  nftId String
  nft   LaunchedNft @relation(fields: [nftId], references: [id], onDelete: Cascade)

  userWalletAddress String

  rewardClaimedRaw Decimal @db.Decimal(38, 0) @default(0)

  depositTransactionId String @unique

  stakedAt  DateTime @default(now())
  unlocksAt DateTime

  status NftStakingPositionStatus @default(ACTIVE)

  claimNonce          String?
  claimNonceExpiresAt DateTime?

  // See VestingContract.disputedTransactionId's comment - same
  // ambiguous-payout guard, reused here since this position's claims
  // go through the same executeStakingPayout().
  disputedTransactionId String?
  disputedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poolId])
  @@index([userWalletAddress])
  @@index([nftId])
  @@index([status])
}

model NftStakingRewardDeposit {
  id String @id @default(cuid())

  poolId String
  pool   NftStakingPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  amountRaw     Decimal @db.Decimal(38, 0)
  transactionId String  @unique

  createdAt DateTime @default(now())

  @@index([poolId])
}

// ZRP Launchpad, phase 7: liquidity farming. Mechanically identical to
// fungible staking (StakingPool/StakingPosition) - same fixed-APY
// accrual formula, same funded-reserve safety, same wallet-native
// stake/claim/unstake primitives - the one real difference is WHAT gets
// staked: an external LP token minted by a DEX (Raydium/Orca/etc.),
// never a LaunchedToken ZRP itself minted. That's why this can't just
// reuse StakingPool.launchedTokenId as a foreign key - there is no
// corresponding LaunchedToken row for someone else's LP mint, only a
// bare mint address the creator supplies. Reward math/payout logic is
// reused as-is from staking-service.ts (computeTotalAccruedRewardRaw /
// computeClaimableRewardRaw / executeStakingPayout); only the reward-
// reserve reserve/refund helpers are duplicated against this table
// (see farming-service.ts). Unlike StakingPool (gated to the
// underlying token's own creator), ANY verified-wallet user may open a
// farming pool - there's no "creator" of someone else's LP token to
// check against, so the only natural gate left is "you're the one
// responsible for actually funding its rewards," the same as every
// other pool-creator-only action here.
model FarmingPool {
  id String @id @default(cuid())

  lpMintAddress String
  lpTokenName   String
  lpTokenSymbol String
  lpDecimals    Int

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  rewardTokenId String
  rewardToken   LaunchedToken @relation(fields: [rewardTokenId], references: [id], onDelete: Cascade)

  apyBasisPoints Int
  lockSeconds    Int
  minStakeRaw    Decimal  @db.Decimal(38, 0)
  maxStakeRaw    Decimal? @db.Decimal(38, 0)

  totalStakedRaw   Decimal @db.Decimal(38, 0) @default(0)
  rewardReserveRaw Decimal @db.Decimal(38, 0) @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions      FarmingPosition[]
  rewardDeposits FarmingRewardDeposit[]

  @@index([creatorId])
  @@index([lpMintAddress])
}

model FarmingPosition {
  id String @id @default(cuid())

  poolId String
  pool   FarmingPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  userWalletAddress String

  amountRaw        Decimal @db.Decimal(38, 0)
  rewardClaimedRaw Decimal @db.Decimal(38, 0) @default(0)

  depositTransactionId String @unique

  stakedAt  DateTime @default(now())
  unlocksAt DateTime

  status StakingPositionStatus @default(ACTIVE)

  claimNonce          String?
  claimNonceExpiresAt DateTime?

  // See VestingContract.disputedTransactionId's comment - same
  // ambiguous-payout guard, reused here since this position's claims
  // go through the same executeStakingPayout().
  disputedTransactionId String?
  disputedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poolId])
  @@index([userWalletAddress])
  @@index([status])
}

model FarmingRewardDeposit {
  id String @id @default(cuid())

  poolId String
  pool   FarmingPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  amountRaw     Decimal @db.Decimal(38, 0)
  transactionId String  @unique

  createdAt DateTime @default(now())

  @@index([poolId])
}

// ZRP Launchpad, phase 8: DAO governance - proposals and token-weighted
// voting ONLY. Deliberately no treasury: no on-chain execution of a
// passed proposal, no multisig, no fund custody beyond what the
// platform already escrows for staking/farming reward reserves. A
// passed proposal is a signal the token's team acts on manually -
// identical in spirit to UpgradeRequest/PaymentRequest being
// admin-reviewed rather than self-executing. This is intentional, not
// a stub: giving an unaudited program custody of a DAO's treasury is
// the single highest-severity class of bug this launchpad could ship,
// and the roadmap explicitly calls for scaffolding here, not that.
//
// Voting power is read live from the voter's on-chain balance of the
// DAO's governance mint at the moment they vote (getSplTokenBalanceRaw
// in dao-service.ts), not a block-height snapshot taken when the
// proposal opened. This is a known, documented limitation shared with
// every simple token-voting DAO that isn't checkpoint-based (unlike
// Compound/Governor Bravo's snapshotted getPriorVotes): a holder could
// in principle vote, move the same tokens to a second wallet, and vote
// again. Double voting FROM THE SAME WALLET on the SAME proposal is
// still hard-blocked (DaoVote's unique [proposalId, voterWalletAddress]
// plus an atomically-consumed per-wallet challenge nonce), and splitting
// a holding across wallets to re-vote costs nothing extra in effort than
// the attacker already had to split it before voting began, so this is
// a real but narrow gap, not an open double-vote bug.
model Dao {
  id String @id @default(cuid())

  launchedTokenId String        @unique
  launchedToken   LaunchedToken @relation(fields: [launchedTokenId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  // Minimum total vote weight (for+against+abstain, raw base units of
  // the governance token) a proposal needs for its outcome to count as
  // PASSED rather than REJECTED for lack of quorum.
  quorumRaw Decimal @db.Decimal(38, 0)
  // Minimum balance of the governance token a wallet must hold to open
  // a new proposal - keeps proposal creation from being spammable by a
  // dust holder.
  proposalThresholdRaw Decimal @db.Decimal(38, 0)
  votingPeriodSeconds  Int     @default(259200) // 3 days

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals DaoProposal[]

  @@index([creatorId])
}

enum DaoVoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

model DaoProposal {
  id String @id @default(cuid())

  daoId String
  dao   Dao    @relation(fields: [daoId], references: [id], onDelete: Cascade)

  title       String
  description String @db.Text

  // The wallet that opened this proposal - wallet-native like every
  // other launchpad action; no ZRP account is implied for voters, only
  // for the DAO's own creator (see Dao.creatorId).
  proposerWalletAddress String

  votingStartsAt DateTime @default(now())
  votingEndsAt   DateTime

  // Cached tallies, raw base units of the governance token - updated
  // atomically alongside each DaoVote insert inside the same
  // transaction, never recomputed by summing votes on every read.
  forRaw     Decimal @db.Decimal(38, 0) @default(0)
  againstRaw Decimal @db.Decimal(38, 0) @default(0)
  abstainRaw Decimal @db.Decimal(38, 0) @default(0)

  // Only the proposer can cancel, and only before votingEndsAt - see
  // computeProposalStatus() in dao-service.ts for how this combines
  // with the time-based ACTIVE/PASSED/REJECTED transition (computed on
  // read, never a stored/cron-flipped status - same pattern as Story's
  // 24h expiry).
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes          DaoVote[]
  voteChallenges DaoVoteChallenge[]

  @@index([daoId])
  @@index([votingEndsAt])
}

model DaoVote {
  id String @id @default(cuid())

  proposalId String
  proposal   DaoProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  voterWalletAddress String
  choice             DaoVoteChoice
  // The voter's on-chain governance-token balance read at the moment
  // they voted - see the model-level doc comment above for why this is
  // a live read, not a proposal-open-time snapshot.
  weightRaw Decimal @db.Decimal(38, 0)

  createdAt DateTime @default(now())

  @@unique([proposalId, voterWalletAddress])
  @@index([proposalId])
}

// Single-use ed25519 challenge nonce for casting a vote, scoped to one
// (proposal, wallet) pair - the multi-voter analogue of the singleton
// claimNonce column every staking/farming position uses, since here
// many different wallets need an outstanding nonce on the same
// proposal at once.
model DaoVoteChallenge {
  id String @id @default(cuid())

  proposalId String
  proposal   DaoProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  walletAddress String
  nonce         String
  expiresAt     DateTime

  createdAt DateTime @default(now())

  @@unique([proposalId, walletAddress])
  @@index([proposalId])
}

// ZRP Launchpad, phase 9: IDO (Initial DEX Offering) launchpad -
// DELIBERATELY NON-CUSTODIAL SCAFFOLDING ONLY. This is the one roadmap
// item where the natural feature (pool third-party contributor funds
// during a sale window, then distribute tokens or refunds based on
// whether a soft cap was met) was evaluated and explicitly declined:
// pooling investor money for a future token distribution is a
// fundamentally different risk class than anything else in this
// launchpad (tips/purchases/staking/farming all move a user's OWN
// funds for something already rendered or already escrowed by the
// depositor themselves) and starts to look like operating a securities
// offering or money-transmission business in most jurisdictions - not
// a call this codebase can make unilaterally. What ships instead is a
// genuinely useful non-custodial piece: campaign metadata plus a
// whitelist application/review workflow, with a mandatory, prominently
// rendered disclosure that ZRP never pools, holds, or distributes
// contribution funds. Approved participants follow the project's own
// participationInstructions to contribute off-platform; that mechanism
// is the project's responsibility, not this schema's.
model IdoCampaign {
  id String @id @default(cuid())

  launchedTokenId String
  launchedToken   LaunchedToken @relation(fields: [launchedTokenId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  title       String
  description String @db.Text

  // Informational only - never enforced or moved by this schema.
  tokenPriceUsdc Decimal @db.Decimal(18, 6)
  softCapUsdc    Decimal @db.Decimal(18, 6)
  hardCapUsdc    Decimal @db.Decimal(18, 6)

  requiresWhitelist Boolean @default(true)
  // How an approved participant actually contributes, off-platform -
  // see the model doc comment above. Rendered verbatim with a
  // non-custodial disclosure banner, never parsed or acted on.
  participationInstructions String @db.Text

  saleStartsAt DateTime
  saleEndsAt   DateTime

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whitelistApplications IdoWhitelistApplication[]

  @@index([creatorId])
  @@index([launchedTokenId])
  @@index([saleEndsAt])
}

enum IdoWhitelistStatus {
  PENDING
  APPROVED
  REJECTED
}

model IdoWhitelistApplication {
  id String @id @default(cuid())

  campaignId String
  campaign   IdoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  applicantWalletAddress String
  contactEmail           String?

  status     IdoWhitelistStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([campaignId, applicantWalletAddress])
  @@index([campaignId])
  @@index([status])
}

// ZRP Launchpad: airdrop - a creator distributing their own already-held
// token supply to a list of recipient wallets. Unlike vesting/staking,
// there is no platform custody or shared reward reserve to protect: the
// creator's own connected wallet signs each batch transaction directly
// (see client-airdrop.ts), so the only thing this model exists for is an
// honest audit trail of what the chain actually recorded - never a
// client-reported claim taken at face value. Each AirdropRecipient row's
// status is set only after verifyAirdropBatchTransaction() independently
// re-derives the real pre/post token-balance delta for that wallet from
// the transaction, the same technique spl-transfer-verify.ts already
// uses for payment-in verification, just applied to arbitrary recipients
// instead of a single platform destination.
model Airdrop {
  id String @id @default(cuid())

  launchedTokenId String
  launchedToken   LaunchedToken @relation(fields: [launchedTokenId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  senderWalletAddress   String
  amountPerRecipientRaw Decimal @db.Decimal(38, 0)

  createdAt DateTime @default(now())

  recipients AirdropRecipient[]

  @@index([launchedTokenId])
  @@index([creatorId])
}

enum AirdropRecipientStatus {
  // Independently verified on-chain: the recipient's token balance for
  // this mint actually increased by exactly amountPerRecipientRaw in
  // the referenced transaction.
  SUCCESS
  // The batch transaction never confirmed, or confirmed with an
  // on-chain error - nothing moved, matching every other Launchpad
  // claim flow's "definite failure" case.
  FAILED
  // The batch transaction broadcast (a signature exists) but its
  // on-chain outcome could not be confirmed client-side (e.g. an RPC
  // timeout) - see AmbiguousMintError/AmbiguousSwapError for the
  // identical rationale. Recorded as-is for the creator's own records;
  // unlike a claim flow there is no shared reserve to protect here, so
  // this status carries no further gating.
  DISPUTED
}

model AirdropRecipient {
  id String @id @default(cuid())

  airdropId String
  airdrop   Airdrop @relation(fields: [airdropId], references: [id], onDelete: Cascade)

  walletAddress String
  status        AirdropRecipientStatus
  // Null only for a FAILED entry whose transaction never broadcast at
  // all (e.g. the wallet rejected the signature request).
  transactionId String?

  createdAt DateTime @default(now())

  // A given transaction can legitimately cover several recipients (one
  // batch), so uniqueness is on the pair, not the signature alone; NULL
  // transactionIds are never considered duplicates of each other.
  @@unique([transactionId, walletAddress])
  @@index([airdropId])
  @@index([walletAddress])
}

/*
 * ============================================================
 * ZRP Launchpad, phase 11: real AMM liquidity
 * ============================================================
 *
 * Pool creation, add/remove liquidity, and LP burn against Raydium's
 * public, already-audited CPMM program (src/lib/launchpad/
 * raydium-pool-service.ts) - never a ZRP-owned program, never a
 * database simulation of on-chain state. Every operation is wallet-
 * signed (the connected wallet, never the platform, owns the
 * liquidity) and independently re-verified against the real
 * transaction before being recorded here; these tables are a cache/
 * index of chain truth, not the source of it.
 */
enum TokenPoolDex {
  RAYDIUM_CPMM
}

enum TokenPoolStatus {
  PENDING
  ACTIVE
  FAILED
}

model TokenPool {
  id String @id @default(cuid())

  // Nullable: a pool can be created for any mint, not only ones ZRP
  // itself launched (matches the scanner/analytics' own "works for any
  // token" posture).
  launchedTokenId String?
  launchedToken   LaunchedToken? @relation(fields: [launchedTokenId], references: [id], onDelete: SetNull)

  dex         TokenPoolDex
  poolAddress String       @unique
  baseMint    String
  quoteMint   String
  lpMint      String
  baseVault   String
  quoteVault  String

  creatorId            String?
  creator              User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  creatorWalletAddress String

  createTransactionId String @unique

  status        TokenPoolStatus @default(PENDING)
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  liquidityEvents LiquidityEvent[]
  trades          TokenTrade[]

  @@index([launchedTokenId])
  @@index([baseMint])
  @@index([creatorId])
}

enum LiquidityEventType {
  ADD
  REMOVE
  BURN
}

enum LiquidityEventStatus {
  // Independently verified on-chain against the real transaction.
  SUCCESS
  // The transaction never broadcast, or confirmed with an on-chain
  // error - nothing moved.
  FAILED
  // Broadcast (a signature exists) but its on-chain outcome could not
  // be confirmed client-side (e.g. an RPC timeout) - identical
  // rationale to AmbiguousMintError/AirdropRecipientStatus.DISPUTED.
  DISPUTED
}

model LiquidityEvent {
  id String @id @default(cuid())

  poolId String
  pool   TokenPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  type   LiquidityEventType
  status LiquidityEventStatus

  walletAddress String
  // Null only for a FAILED entry whose transaction never broadcast at
  // all (e.g. the wallet rejected the signature request).
  transactionId String? @unique

  lpAmountRaw    Decimal? @db.Decimal(38, 0)
  baseAmountRaw  Decimal? @db.Decimal(38, 0)
  quoteAmountRaw Decimal? @db.Decimal(38, 0)

  createdAt DateTime @default(now())

  @@index([poolId])
  @@index([walletAddress])
}

enum TradeSide {
  BUY
  SELL
}

// A trade's venue: the original Raydium CPMM pool swaps from PR #444, or
// a pump-style bonding-curve buy/sell (see pump-curve-service.ts). Both
// land in the same table keyed by mintAddress so volume aggregation
// (getVolumeBuckets / getVolumeBucketsForMint) and AnalyticsSnapshot never
// have to merge two separate trade logs - a mint's total volume is just
// every TokenTrade row for it, whichever venue it traded on. Defaults to
// the pre-existing value so the migration backfills every historical row
// correctly without a data migration script.
enum TradeSource {
  POOL_SWAP
  BONDING_CURVE
}

// Indexed, not read live from RPC on every analytics request - a pool's
// full trade history can be thousands of transactions, far too slow and
// RPC-expensive to re-fetch per page view. TokenVolumeSyncState below is
// the resumable cursor the background indexing job
// (src/app/api/cron/launchpad-volume-sync) uses to index incrementally;
// this table is the resulting append-only log aggregation queries read
// from. txSignature is globally unique, so a resumed/retried sync tick
// can never double-count the same trade.
model TokenTrade {
  id String @id @default(cuid())

  // Null for a BONDING_CURVE trade: it happens directly against the
  // mint's pump bonding-curve PDA, never a TokenPool row. Always set for
  // POOL_SWAP. onDelete: SetNull (not Cascade) because a curve trade's
  // row has no pool to cascade from in the first place, and a pool-swap
  // trade's history should outlive a pool record being removed.
  poolId String?
  pool   TokenPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)

  source TradeSource @default(POOL_SWAP)

  mintAddress    String
  txSignature    String    @unique
  side           TradeSide
  baseAmountRaw  Decimal   @db.Decimal(38, 0)
  quoteAmountRaw Decimal   @db.Decimal(38, 0)
  walletAddress  String

  blockTime DateTime
  slot      Int

  createdAt DateTime @default(now())

  @@index([poolId, blockTime])
  @@index([mintAddress, blockTime])
  @@index([mintAddress, source, blockTime])
}

// Real, independently-verified pump-fun bonding-curve graduations - never
// a simulated/inferred state. Recorded only after pump-curve-service.ts
// re-reads the curve's own `complete` flag (or the on-chain CompleteEvent)
// directly from chain; mintAddress is unique because a curve graduates
// at most once and `complete` never reverts to false.
model GraduationEvent {
  id String @id @default(cuid())

  mintAddress         String @unique
  bondingCurveAddress String
  // The pump-amm canonical pool pump migrates liquidity into - populated
  // once that pool account is confirmed to exist on-chain; null means
  // graduation was detected (complete == true) but the destination pool
  // has not yet been independently confirmed.
  poolAddress String?

  // true only when `signature`/`slot`/`blockTime` below were read from a
  // real, decoded CompletePumpAmmMigrationEvent for this exact mint (see
  // pump-event-service.ts's parseMigrationEvent) - the actual migration
  // transaction, not an inference. false means checkGraduation could not
  // find that event within its bounded signature-history search window
  // and fell back to "the newest confirmed signature touching the
  // bonding-curve account" as a practical anchor; the graduated:true
  // signal itself (the on-chain `complete` flag) is equally real either
  // way - only the *attribution* of this specific signature differs.
  migrationVerified Boolean @default(false)

  // Real amounts from the decoded CompletePumpAmmMigrationEvent - the
  // base tokens and quote (sol_amount; actually the curve's quote mint)
  // moved into the new pool, and the migration fee pump charged. Null
  // when migrationVerified is false (nothing decoded to read them from).
  mintAmountRaw            Decimal? @db.Decimal(38, 0)
  solAmountLamports        Decimal? @db.Decimal(38, 0)
  poolMigrationFeeLamports Decimal? @db.Decimal(38, 0)

  // Null only when graduation was detected (complete == true) but no
  // confirmed signature could be found for the curve account at detection
  // time (e.g. RPC history already pruned) - see checkGraduation's
  // anchorSignature doc comment. A nullable unique column allows this to
  // happen for more than one mint; Postgres never treats two NULLs as a
  // duplicate.
  signature String?  @unique
  slot      Int?
  blockTime DateTime?

  detectedAt DateTime @default(now())

  // Stamped every time findVerifiedMigration actually runs (found or not),
  // never on a plain checkGraduation read. Gates retries of that expensive,
  // multi-getTransaction search behind MIGRATION_SEARCH_COOLDOWN_MS in
  // pump-curve-service.ts so a still-unverified graduated token being
  // viewed repeatedly (a popular token page, not just one user retrying)
  // cannot re-trigger the full search on every single page load - without
  // this, an aged-out migration signature would mean paying the search's
  // full RPC cost once per page view, forever, for as long as the token
  // stays unverified.
  lastMigrationSearchAt DateTime?

  @@index([mintAddress])
}

// Periodic, real historical snapshots for the Launchpad's price/volume/
// liquidity/holder charts and discovery ranking - never a fabricated or
// interpolated data point. One row per (mint, takenAt) written by the
// launchpad-analytics-snapshot cron on a fixed interval (see that route's
// comment for the exact cadence and why); chart/ranking queries resample
// from these real rows rather than ever synthesizing a value for a period
// with no snapshot. priceQuote/priceTokenRaw are stored as the exact
// integer virtual reserves a bonding-curve price is derived from (never
// pre-divided into a float) so a chart can recompute an exact price at
// render time; both are null when the mint has no live bonding curve to
// read a price from at snapshot time (e.g. already graduated, or a plain
// LaunchedToken with no curve at all).
model AnalyticsSnapshot {
  id String @id @default(cuid())

  mintAddress String
  takenAt     DateTime

  priceQuoteLamports Decimal? @db.Decimal(38, 0)
  priceTokenRaw      Decimal? @db.Decimal(38, 0)
  marketCapLamports  Decimal? @db.Decimal(38, 0)
  // Bonding-curve progress toward graduation in basis points (10_000 =
  // 100%), from curveProgressBps at snapshot time - null when the mint
  // has no live pump curve to read progress from. Powers the "Graduating"
  // discovery filter and a historical progress view without a live RPC
  // call per request.
  curveProgressBps Int?

  liquidityTotalLamports Decimal @db.Decimal(38, 0) @default(0)
  poolCount              Int     @default(0)

  // Null means "not available this snapshot" (see full-holder-count-
  // service.ts's own honest UNAVAILABLE status) - never backfilled as 0,
  // which would be indistinguishable from a real zero-holder mint.
  holderCount Int?

  // Deltas since the previous snapshot for this mint, not cumulative
  // totals - summing a range of rows gives that range's real volume.
  buyVolumeLamports  Decimal @db.Decimal(38, 0) @default(0)
  sellVolumeLamports Decimal @db.Decimal(38, 0) @default(0)
  tradeCount         Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([mintAddress, takenAt])
  @@index([mintAddress, takenAt])
}

// One row per pool - the resumable cursor for the background
// trade-indexing job. Kept separate from TokenPool itself so a sync
// failure/restart never risks touching the pool's own on-chain-verified
// record.
model TokenVolumeSyncState {
  id String @id @default(cuid())

  poolAddress   String    @unique
  lastSignature String?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ZRP Market Plus: luxury-only listings marketplace. Deliberately NOT
// a payments/escrow system - price is informational, a deal is closed
// off-platform between buyer and seller after they connect via the
// existing messaging system. Mirrors AdCampaign's moderation shape
// (PENDING_REVIEW by default, staff approve/reject, rejectionReason +
// reviewedBy/reviewedAt) since that's the closest existing analog to
// "user-submitted content that must pass moderation before going
// live" for something other than a Post.
model Listing {
  id String @id @default(cuid())

  sellerId String
  seller   User   @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  category    ListingCategory
  title       String
  description String          @db.Text

  // Either a real price or priceOnRequest - validated together at the
  // API layer, not enforceable as a DB constraint with Prisma alone.
  price          Decimal? @db.Decimal(18, 2)
  currency       String   @default("USD")
  priceOnRequest Boolean  @default(false)

  location String?

  imageUrls String[] @default([])
  videoUrl  String?

  status          ListingStatus @default(PENDING_REVIEW)
  rejectionReason String?       @db.Text
  reviewedBy      String?
  reviewedAt      DateTime?

  views Int @default(0)

  // Listings aren't meant to sit forever - a stale "for sale" luxury
  // asset is exactly the kind of thing that erodes trust in a
  // marketplace. Set on approval (90 days out); expired listings stop
  // showing in browse/search but aren't deleted.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites ListingFavorite[]
  reports   Report[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([status, category])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model ListingFavorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model AdCampaign {
  id String @id @default(cuid())

  advertiserId String
  advertiser   User   @relation("AdAdvertiser", fields: [advertiserId], references: [id], onDelete: Cascade)

  postId String @unique
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  name   String
  status AdCampaignStatus @default(DRAFT)

  bidType   AdBidType
  bidAmount Decimal   @db.Decimal(18, 6)

  budgetTotal Decimal @db.Decimal(18, 6)
  budgetSpent Decimal @default(0) @db.Decimal(18, 6)

  targetUrl String?

  startDate DateTime?
  endDate   DateTime?

  rejectionReason String? @db.Text

  reviewedBy String?
  reviewedAt DateTime?

  // Verified on-chain USDC payment that funded budgetTotal - set once,
  // by POST /api/ads/campaigns/[id]/pay, the same verifyUsdcTransaction +
  // ConsumedPaymentTransaction pattern src/app/api/creator/tip already
  // uses. Never trust a client-claimed "paid" state without this.
  paymentTransactionId String?   @unique
  paidAt               DateTime?
  paymentFailureReason String?   @db.Text

  // Staff-only, never returned on advertiser-facing routes - separate
  // from rejectionReason, which IS shown to the advertiser.
  adminNote String? @db.Text

  // Minimal, privacy-respecting targeting: ISO-3166-1 alpha-2 codes,
  // matched against the normalized User.countryCode (never the
  // free-text User.country, which a user could type as "Switzerland"/
  // "Suisse"/"CH" - see src/lib/geo/country.ts and
  // docs/user-geography-and-acquisition.md). Empty means untargeted/all
  // countries.
  targetCountries String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impressions AdImpression[]
  clicks      AdClick[]

  @@index([advertiserId])
  @@index([status])
  @@index([status, startDate, endDate])
}

model AdImpression {
  id String @id @default(cuid())

  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("AdImpressionUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([campaignId, createdAt])
  @@index([userId])
}

model AdClick {
  id String @id @default(cuid())

  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("AdClickUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([campaignId, createdAt])
  @@index([userId])
}

model SupportTicket {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String

  category TicketCategory @default(GENERAL)
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)

  message String @db.Text

  attachments String[]

  assignedTo String?

  assignedAdmin User? @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  resolution String?   @db.Text

  userAgent String?
  ipAddress String?
  referrer  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies  TicketReply[]
  feedback TicketFeedback?

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([status, priority])
}

model TicketReply {
  id String @id @default(cuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String @db.Text

  isInternal Boolean @default(false)

  attachments String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@index([isInternal])
}

model TicketFeedback {
  id String @id @default(cuid())

  ticketId String        @unique
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  rating   Int?
  comment  String?  @db.Text
  resolved Boolean?

  createdAt DateTime @default(now())
}

model AIConversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String @default("New Conversation")

  messages AIMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model AIMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String
  content String @db.Text
  model   String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model AIDailyUsage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  messages   Int @default(0)
  tokensUsed Int @default(0)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// Repost daily quota - atomic reservation, same shape and pattern as
// AIDailyUsage/reserveAiMessage (src/lib/ai-quota.ts): a single
// conditional UPDATE the database serialises, so N concurrent repost
// requests can never all pass a stale pre-increment read. See
// src/lib/repost-quota.ts for the reservation logic and
// docs/notifications-social-interactions.md for why this exists (no
// repost quota existed anywhere in the codebase before this model).
model RepostDailyUsage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  reposts Int @default(0)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ─── ZRP NEWS ────────────────────────────────────────────────────────
// Dedicated editorial news system.
// Completely separate from Post, Shorts and Video systems.

model NewsArticle {
  id String @id @default(cuid())

  title String @db.Text
  slug  String @unique

  excerpt String? @db.Text
  content String  @db.Text

  coverImage String?

  sourceName String?
  sourceUrl  String?

  category NewsArticleCategory @default(WORLD)
  status   NewsArticleStatus   @default(DRAFT)

  authorId String
  author   User   @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  views Int @default(0)

  featured Boolean @default(false)

  publishedAt DateTime?

  // ─── Journalist editorial workflow ──────────────────────────
  // Set when a journalist submits a DRAFT for admin review.
  submittedAt DateTime?

  // Feedback left by the admin/moderator who reviewed the
  // submission: shown to the journalist, especially on rejection.
  reviewNote String? @db.Text

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("NewsReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@index([featured])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([category, publishedAt])
  @@index([reviewedById])
}

// ─── Admin Audit Log ────────────────────────────────────────────────
// Immutable record of sensitive administrator actions (moderation,
// role changes, payment/withdrawal decisions, account security
// events). Deliberately has no relation/FK to User: an audit trail
// must survive the actor or target account being deleted later, so it
// is never cascade-deleted along with them.
model AuditLog {
  id String @id @default(cuid())

  actorId       String
  actorUsername String?

  action     String // e.g. "user.ban", "user.role_change", "withdrawal.approve"
  targetType String? // e.g. "User", "WithdrawalRequest"
  targetId   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}

// A real, admin-recorded record of a charity disbursement ZRP actually
// made - never auto-generated, never estimated. This is deliberately
// separate from the automatically-computed "committed" figure (the sum
// of Tip.charityAmount / PremiumPurchase.charityAmount on completed
// transactions): committed is what the 35% policy owes so far, disbursed
// is proof money actually left ZRP and reached a real beneficiary.
model CharityDisbursement {
  id String @id @default(cuid())

  beneficiaryName String
  cause           String // matches one of the four /charity page categories
  amount          Decimal @db.Decimal(18, 2)
  currency        String  @default("USD")

  disbursedAt DateTime
  note        String?  @db.Text
  proofUrl    String? // link to a receipt/confirmation the admin can point to

  recordedById       String
  recordedByUsername String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disbursedAt])
  @@index([cause])
}

// ─── ZRP PLAY ────────────────────────────────────────────────────────
// Social entertainment/gaming hub: quick challenges (trivia, memory,
// logic), 1v1 duels, XP/levels/streaks, achievements and leaderboards.
// Reuses User, Follow, Notification, Report/Appeal, Message and Post
// rather than building parallel systems for any of those.

model PlayChallenge {
  id String @id @default(cuid())

  // Null for system/daily challenges (including AI-generated ones with
  // no specific human author); SetNull rather than Cascade so a
  // deleted account doesn't take other players' history/leaderboard
  // entries with it - same reasoning as Post.author-adjacent deletes
  // elsewhere in this schema.
  creatorId String?
  creator   User?   @relation("PlayChallengeCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  type        PlayChallengeType
  title       String
  description String?           @db.Text
  difficulty  String            @default("medium") // easy | medium | hard

  // Shape depends on `type` instead of one table per mini-game - see
  // src/lib/play/scoring.ts (validate/strip/score) and src/lib/play/registry.ts
  // (metadata + score dispatch) for the authoritative per-type contract:
  // TRIVIA:   { questions: [{ q, options: string[], correctIndex }] }
  // MEMORY:   { pairs: string[] } (each value appears twice, shuffled client-side)
  // LOGIC:    { prompt, options: string[], correctIndex } or { prompt, answer } for free text
  // REACTION: { rounds: number } - stimulus/tap round count, no other content
  // SEQUENCE: { sequence: string[] } - ordered items the player reproduces (Simon-says)
  content Json

  maxScore      Int       @default(100)
  isDaily       Boolean   @default(false)
  activeDate    DateTime? // date-only marker (UTC midnight) for the daily-challenge slot
  isAiGenerated Boolean   @default(false)

  status        PlayChallengeStatus @default(ACTIVE)
  removedReason String?             @db.Text

  playCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts PlayAttempt[]
  duels    PlayDuel[]
  reports  Report[]

  @@index([type])
  @@index([status])
  @@index([isDaily, activeDate])
  @@index([creatorId])
  @@index([createdAt])
  @@index([playCount])
}

model PlayAttempt {
  id String @id @default(cuid())

  challengeId String
  challenge   PlayChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score    Int
  timeMs   Int
  xpEarned Int @default(0)

  // Set when this attempt is one side of a duel rather than a solo play.
  duelId String?
  duel   PlayDuel? @relation(fields: [duelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([challengeId])
  @@index([userId])
  @@index([duelId])
  @@index([userId, createdAt])
}

model PlayDuel {
  id String @id @default(cuid())

  challengeId String
  challenge   PlayChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  challengerId String
  challenger   User   @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)

  opponentId String
  opponent   User   @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  status PlayDuelStatus @default(PENDING)

  challengerScore Int?
  opponentScore   Int?
  winnerId        String?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  completedAt DateTime?
  expiresAt   DateTime

  attempts PlayAttempt[]

  @@index([challengerId])
  @@index([opponentId])
  @@index([status])
  @@index([challengeId])
}

// One row per user - their overall PLAY stats. Kept separate from User
// itself (like CreatorProfile) so the core User model doesn't grow a
// gamification-specific column set.
model PlayProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp Int @default(0)
  level   Int @default(1)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastPlayedAt  DateTime?

  challengesCompleted Int @default(0)
  duelsWon            Int @default(0)
  duelsPlayed         Int @default(0)

  updatedAt DateTime @updatedAt

  @@index([totalXp])
}

// Unlocked achievements only - the achievement catalog itself (name,
// description, icon, XP reward, unlock criteria) is small, static and
// versioned in code (src/lib/play/achievements.ts), not the database,
// so shipping a new achievement never needs a data migration.
model PlayUserAchievement {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementKey String
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
  @@index([userId])
}

// ─── ZRP OPPORTUNITY ──────────────────────────────────────────────
// Connects creators, developers, students, employees, businesses,
// universities, hotels, hospitals and organizations with real
// opportunities: jobs, remote work, internships, scholarships,
// mentorship, freelance projects, partnerships, sponsorships,
// hackathons, training and collaboration. Same PENDING_REVIEW ->
// staff approve/reject -> live, reportable-after-the-fact shape as
// Listing (see the comment on Listing above) - not a payments system,
// applying happens on-platform (OpportunityApplication) or via an
// external link (externalUrl); no money changes hands here.
model OpportunityListing {
  id String @id @default(cuid())

  posterId String
  poster   User   @relation("OpportunityPoster", fields: [posterId], references: [id], onDelete: Cascade)

  type OpportunityType

  title            String
  description      String  @db.Text
  organizationName String?

  skills   String[] @default([])
  location String?
  remote   Boolean  @default(false)

  // Compensation is informational only, same reasoning as
  // Listing.price/priceOnRequest - ZRP never verifies or escrows pay.
  isPaid           Boolean @default(true)
  compensationInfo String?

  // If set, "Apply" sends the applicant to the poster's own site/ATS
  // instead of creating an OpportunityApplication row.
  externalUrl String?

  deadline DateTime?

  status          OpportunityStatus @default(PENDING_REVIEW)
  rejectionReason String?           @db.Text
  reviewedBy      String?
  reviewedAt      DateTime?

  views     Int       @default(0)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications OpportunityApplication[]
  savedBy      OpportunitySavedListing[]
  reports      Report[]

  @@index([posterId])
  @@index([status])
  @@index([type])
  @@index([status, type])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model OpportunityApplication {
  id String @id @default(cuid())

  listingId String
  listing   OpportunityListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  applicantId String
  applicant   User   @relation("OpportunityApplicant", fields: [applicantId], references: [id], onDelete: Cascade)

  coverNote String? @db.Text
  resumeUrl String? // uploaded via the chatFile-shaped {pdf,text,blob} route

  status OpportunityApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, applicantId])
  @@index([listingId])
  @@index([applicantId])
  @@index([status])
}

model OpportunitySavedListing {
  id String @id @default(cuid())

  userId String
  user   User   @relation("OpportunitySaver", fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   OpportunityListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

// ─── ZRP HELP ─────────────────────────────────────────────────────
// A verified humanitarian space: only accounts with badgeType
// "organization" (the same verification signal already surfaced on
// Trust Passport, granted by a full admin via PUT /api/admin/users/[id]
// - deliberately no new verification system) may publish a campaign.
// Same PENDING_REVIEW -> staff approve/reject -> live shape as
// Listing. Money movement reuses the exact same on-chain USDC rail as
// Tip/PremiumPurchase (see CreatorProfile/Tip/WithdrawalRequest above)
// instead of a new payment system - HelpContribution is a pooled
// version of Tip (many contributors -> one campaign balance instead
// of one sender -> one CreatorProfile), and HelpWithdrawalRequest
// mirrors WithdrawalRequest's atomic reserve-on-request /
// release-on-failure-or-rejection shape exactly. Unlike creator tips,
// contributions here carry NO platform fee (100% passthrough) - this
// is deliberately not a revenue feature.
model HelpCampaign {
  id String @id @default(cuid())

  organizerId String
  organizer   User   @relation("HelpOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  category  HelpCategory
  needTypes HelpNeedType[] @default([])

  title       String
  description String  @db.Text
  location    String?

  // Only meaningful when needTypes includes MONEY - enforced in the
  // API route, not the schema (a campaign asking purely for supplies
  // or volunteers has no goal amount at all).
  goalAmount     Decimal? @db.Decimal(18, 2)
  currency       String   @default("USDC")
  raisedAmount   Decimal  @default(0) @db.Decimal(18, 6)
  balance        Decimal  @default(0) @db.Decimal(18, 6)
  totalWithdrawn Decimal  @default(0) @db.Decimal(18, 6)

  imageUrls String[] @default([])
  proofUrls String[] @default([]) // optional evidence/documentation links, for transparency

  status          HelpCampaignStatus @default(PENDING_REVIEW)
  rejectionReason String?            @db.Text
  reviewedBy      String?
  reviewedAt      DateTime?

  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributions      HelpContribution[]
  offers             HelpOffer[]
  withdrawalRequests HelpWithdrawalRequest[]
  reports            Report[]

  @@index([organizerId])
  @@index([status])
  @@index([category])
  @@index([status, category])
  @@index([createdAt])
}

model HelpContribution {
  id String @id @default(cuid())

  campaignId String
  campaign   HelpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contributorId String
  contributor   User   @relation("HelpContributor", fields: [contributorId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(18, 6)
  currency String  @default("USDC")

  message     String? @db.Text
  isAnonymous Boolean @default(false)

  transactionId String?           @unique
  status        TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([contributorId])
}

// Non-monetary help pledges (supplies/skills/volunteers) - money goes
// through HelpContribution instead. No separate contact-info field:
// the organizer reaches an offerer through the existing messaging
// system once they decide to follow up.
model HelpOffer {
  id String @id @default(cuid())

  campaignId String
  campaign   HelpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  offererId String
  offerer   User   @relation("HelpOfferer", fields: [offererId], references: [id], onDelete: Cascade)

  needType HelpNeedType
  message  String       @db.Text

  status HelpOfferStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([offererId])
  @@index([status])
}

model HelpWithdrawalRequest {
  id String @id @default(cuid())

  campaignId String
  campaign   HelpCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  organizerId String
  organizer   User   @relation("HelpWithdrawalOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(18, 6)
  currency String  @default("USDC")

  walletAddress String

  status WithdrawalStatus @default(PENDING)

  transactionHash String?
  processedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([organizerId])
  @@index([status])
}

model MusicArtist {
  id          String        @id @default(cuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?       @db.Text
  avatarUrl   String?
  bannerUrl   String?
  verified    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  albums      MusicAlbum[]
  tracks      MusicTrack[]
  followers   MusicFollow[]

  @@index([displayName])
}

model MusicAlbum {
  id          String       @id @default(cuid())
  artistId    String
  artist      MusicArtist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title       String
  description String?      @db.Text
  coverUrl    String?
  coverKey    String?
  releaseDate DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tracks      MusicTrack[]

  @@index([artistId])
}

model MusicTrack {
  id            String               @id @default(cuid())
  artistId      String
  artist        MusicArtist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  albumId       String?
  album         MusicAlbum?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  title         String
  description   String?              @db.Text
  audioUrl      String
  audioKey      String?
  coverUrl      String?
  coverKey      String?
  durationSec   Int?
  genre         String?
  explicit      Boolean              @default(false)
  status        String               @default("PUBLISHED")
  playCount     Int                  @default(0)
  // Position of this track within its album (MusicTrack.albumId), NULL
  // when the track isn't in an album. Nullable and additive - existing
  // rows simply sort last (see the tracks-by-album ordering, which
  // falls back to createdAt) until an artist explicitly reorders.
  trackNumber   Int?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  likes         MusicLike[]
  playlistItems MusicPlaylistTrack[]
  history       MusicHistory[]

  @@index([artistId])
  @@index([albumId])
  @@index([status])
  @@index([createdAt])
}

model MusicPlaylist {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?              @db.Text
  coverUrl    String?
  isPublic    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  tracks      MusicPlaylistTrack[]

  @@index([userId])
}

model MusicPlaylistTrack {
  id         String        @id @default(cuid())
  playlistId String
  playlist   MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      MusicTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int           @default(0)
  addedAt    DateTime      @default(now())

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model MusicLike {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, trackId])
  @@index([trackId])
}

model MusicFollow {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String
  artist    MusicArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, artistId])
  @@index([artistId])
}

model MusicHistory {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId       String
  track         MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  secondsPlayed Int        @default(0)
  completed     Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([trackId])
}

// ════════════════════════════════════════════════════════════════════
// ZRP NEWS NETWORK
// ════════════════════════════════════════════════════════════════════
//
// An automated *editorial* system, not a bot farm. Every identity it
// publishes through is an openly-labelled ZRP editorial feed backed by
// a normal User row, so following, liking, commenting, reporting,
// blocking and moderation all work exactly as they do for any other
// account - there is no parallel social system here, and no fabricated
// human personas.
//
// Content flows: NewsSource -> NewsStorySource -> NewsStory (a
// deduplicated real-world event) -> NewsRendition (one per language)
// -> NewsPublication -> Post.

// An official ZRP editorial identity (e.g. "ZRP News World"). One-to-one
// with a User so it reuses the whole existing profile/social stack
// rather than introducing a second account architecture.
model NewsFeed {
  id  String @id @default(cuid())
  key String @unique // stable slug, e.g. "zrp-news-switzerland"

  displayName String
  description String? @db.Text

  userId String @unique
  user   User   @relation("EditorialFeedUser", fields: [userId], references: [id], onDelete: Cascade)

  region   NewsRegion @default(GLOBAL)
  country  String? // ISO-3166-1 alpha-2, null for regional/global feeds
  language String     @default("en")
  timezone String     @default("UTC") // IANA zone, for local-hour scheduling

  topics NewsTopic[] @default([])

  // Feeds are provisioned disabled. Turning one on is an explicit,
  // audited admin action - provisioning 100 identities must never mean
  // 100 feeds start publishing.
  enabled Boolean @default(false)
  isPilot Boolean @default(false)

  // Anti-spam envelope, enforced by the scheduler on every cycle.
  minMinutesBetweenPosts Int @default(180)
  maxPostsPerDay         Int @default(6)

  lastPublishedAt DateTime?

  publications NewsPublication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([region])
  @@index([country])
  @@index([language])
}

// A publicly available feed (RSS/Atom) or official announcement channel
// we are permitted to summarise and link to. Full article text is never
// stored or republished - see src/lib/news/ingest.ts.
model NewsSource {
  id  String @id @default(cuid())
  key String @unique

  name        String
  publisher   String
  feedUrl     String  @unique
  homepageUrl String?

  region   NewsRegion  @default(GLOBAL)
  country  String?
  language String      @default("en")
  topics   NewsTopic[] @default([])

  // 1 = official authority (government, airport, airline, regulator)
  // 2 = established news organisation
  // 3 = everything else. Cross-corroboration requirements are stricter
  // the higher this number is.
  trustTier Int     @default(2)
  official  Boolean @default(false)

  // Whether this source's preview images may be referenced. Defaults
  // false: an image is only used when the source's own terms clearly
  // allow it, which is a per-source editorial decision, not a guess.
  allowImages Boolean @default(false)

  // Attribution string that must accompany anything derived from this
  // source, when the source requires wording of its own.
  attribution String?

  enabled Boolean          @default(true)
  status  NewsSourceStatus @default(HEALTHY)

  fetchIntervalMinutes Int @default(60)

  lastFetchedAt DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?   @db.Text

  consecutiveFailures Int       @default(0)
  backoffUntil        DateTime?

  // Conditional-GET state, so a polite re-fetch costs the publisher a
  // 304 rather than a full transfer.
  etag         String?
  lastModified String?

  itemsIngested Int @default(0)

  references NewsStorySource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, backoffUntil])
  @@index([status])
  @@index([region])
  @@index([country])
}

// One real-world event, after deduplication. Several sources reporting
// the same thing collapse into a single story with several references,
// which is what stops the feed filling with fifteen near-identical
// posts about one airport closure.
model NewsStory {
  id String @id @default(cuid())

  // Stable hash of the normalised headline + entity tokens. The unique
  // constraint is the last line of defence against a double-ingest race
  // creating two stories for one event.
  fingerprint     String @unique
  normalizedTitle String @db.Text

  title String @db.Text

  // The verbatim source material (headline + source-provided summary
  // snippets) handed to the summariser. Retained so an admin can always
  // compare what was published against what the sources actually said,
  // and so groundedness checks are reproducible.
  sourceMaterial String @db.Text

  topic    NewsTopic  @default(WORLD)
  region   NewsRegion @default(GLOBAL)
  country  String?
  language String     @default("en")

  confidence NewsConfidence @default(DEVELOPING)
  sensitive  Boolean        @default(false)
  isBreaking Boolean        @default(false)
  isTravel   Boolean        @default(false)

  importance  Float @default(0)
  sourceCount Int   @default(1)

  imageUrl    String? @db.Text
  imageCredit String?

  status          NewsStoryStatus @default(NEW)
  rejectionReason String?         @db.Text

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  publishedAt DateTime?

  // Corrections are additive and visible: the note is appended to every
  // publication of the story rather than the original being silently
  // rewritten out of existence.
  correctionNote String?   @db.Text
  correctedAt    DateTime?

  references   NewsStorySource[]
  renditions   NewsRendition[]
  publications NewsPublication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([topic])
  @@index([region])
  @@index([country])
  @@index([isTravel])
  @@index([status, importance])
  @@index([firstSeenAt])
  @@index([normalizedTitle])
}

// A single source's report of a story: the attribution record. `url` is
// unique, which also makes re-ingesting the same article idempotent.
model NewsStorySource {
  id String @id @default(cuid())

  storyId String
  story   NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  sourceId String
  source   NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  url     String  @unique @db.Text
  title   String  @db.Text
  excerpt String? @db.Text

  imageUrl    String?   @db.Text
  publishedAt DateTime?

  createdAt DateTime @default(now())

  @@index([storyId])
  @@index([sourceId])
  @@index([publishedAt])
}

// The generated, publishable text for one story in one language. Always
// an original concise summary written from `NewsStory.sourceMaterial`,
// never a copy of a source article.
model NewsRendition {
  id String @id @default(cuid())

  storyId String
  story   NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  language String

  headline String @db.Text
  body     String @db.Text

  status NewsRenditionStatus @default(PENDING)
  model  String?
  error  String?             @db.Text

  // Report from the groundedness validator (unsupported numbers, quotes
  // or URLs found in the generated text). Kept for admin inspection.
  validation Json?

  publications NewsPublication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storyId, language])
  @@index([status])
  @@index([language])
}

// One rendition, published once, through one feed. `idempotencyKey` is
// what makes a retried or overlapping pipeline run incapable of posting
// the same story twice.
model NewsPublication {
  id String @id @default(cuid())

  idempotencyKey String @unique

  storyId String
  story   NewsStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  renditionId String
  rendition   NewsRendition @relation(fields: [renditionId], references: [id], onDelete: Cascade)

  feedId String
  feed   NewsFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  language String

  postId String? @unique
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  status NewsPublicationStatus @default(SCHEDULED)

  scheduledFor DateTime
  publishedAt  DateTime?

  attempts Int     @default(0)
  error    String? @db.Text

  removedAt     DateTime?
  removedReason String?   @db.Text

  correctionNote String?   @db.Text
  correctedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([feedId, publishedAt])
  @@index([storyId])
  @@index([language])
  @@index([publishedAt])
}

// Telemetry for one pipeline cycle. Powers the admin dashboard's real
// numbers - there is no estimated or hard-coded figure on that screen.
model NewsJobRun {
  id String @id @default(cuid())

  trigger String        @default("cron") // "cron" | "manual"
  status  NewsJobStatus @default(RUNNING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  sourcesFetched Int @default(0)
  sourcesFailed  Int @default(0)
  itemsIngested  Int @default(0)

  storiesCreated      Int @default(0)
  duplicatesPrevented Int @default(0)

  renditionsGenerated Int @default(0)
  renditionsFailed    Int @default(0)

  published       Int @default(0)
  publishFailures Int @default(0)

  error   String? @db.Text
  details Json?

  @@index([status])
  @@index([startedAt])
}

// Single-row global control panel for the automation. Ships paused.
model NewsAutomationSetting {
  id String @id @default("singleton")

  paused Boolean @default(true)

  enabledLanguages String[]     @default(["en", "fr", "de", "it"])
  // Empty array means "no restriction" for each of these three.
  enabledTopics    NewsTopic[]  @default([])
  enabledRegions   NewsRegion[] @default([])
  enabledCountries String[]     @default([])

  maxPublicationsPerCycle Int @default(12)
  maxPublicationsPerDay   Int @default(120)

  // Floor between any two publications platform-wide, so even a
  // misconfigured set of feeds cannot burst.
  minMinutesBetweenPublications Int @default(4)

  // Sensitive stories are never auto-published while this is on; they
  // wait in the admin queue for a human.
  requireHumanReviewForSensitive Boolean @default(true)

  lastCycleAt DateTime?
  nextCycleAt DateTime?

  updatedAt DateTime @updatedAt
}

// ─── ZRP Communities ───────────────────────────────────────────
// A real, database-backed community: membership, category and a
// creator - not the trending-hashtag reskin the native apps shipped
// before this. A community's "feed" is derived from its `hashtag`
// field via the existing Post.hashtags array (no new post-tagging
// system needed) rather than a separate community-post join table.
enum CommunityCategory {
  TRAVEL
  PHOTOGRAPHY
  NATURE
  TECHNOLOGY
  HEALTH_FITNESS
  ART_DESIGN
  GENERAL
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

model Community {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String            @db.Text
  category    CommunityCategory @default(GENERAL)
  // The single hashtag whose posts make up this community's feed
  // (e.g. "travel" for the Travel community). Stored without the
  // leading "#", lowercase, matched against Post.hashtags.
  hashtag     String
  iconUrl     String?
  memberCount Int               @default(0)

  createdById String?
  createdBy   User?   @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members        CommunityMember[]
  liveAudioRooms LiveAudioRoom[]
  liveVideoRooms LiveVideoRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([hashtag])
}

model CommunityMember {
  id String @id @default(cuid())

  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("CommunityMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  role     CommunityRole @default(MEMBER)
  joinedAt DateTime      @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

// ─── ZRP Live Audio ──────────────────────────────────────────────
// Twitter-Spaces-style multi-party live audio rooms. Media itself flows
// through an external SFU (LiveKit - see docs/live-audio-architecture.md
// for why a P2P mesh, which is what ZRP's existing 1:1 calls use,
// cannot scale to this); everything here is the durable, authoritative
// side of that: who is allowed to be in the room, at what role, and
// what happened. Optionally scoped to a Community via communityId -
// reuses CommunityMember for the "is this viewer allowed to see/join a
// COMMUNITY-visibility room" check rather than inventing a second
// membership system.
enum LiveAudioRoomStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum LiveAudioVisibility {
  PUBLIC
  COMMUNITY
  PRIVATE
}

enum LiveAudioParticipantRole {
  LISTENER
  SPEAKER
  MODERATOR
  HOST
}

enum LiveAudioSpeakerRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LiveAudioModerationActionType {
  MUTE
  UNMUTE
  REMOVE
  PROMOTE_SPEAKER
  DEMOTE_SPEAKER
}

model LiveAudioRoom {
  id String @id @default(cuid())

  hostId String
  host   User   @relation("LiveAudioHost", fields: [hostId], references: [id], onDelete: Cascade)

  // Optional Community scoping - see CommunityMember note above. Null
  // for a standalone room.
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  title       String
  description String?             @db.Text
  // A free-form tag, not a new enum: unlike Community (whose category
  // drives its own directory), a Live Audio room's category is purely
  // descriptive for the discovery list and never gates access or
  // membership, so it doesn't need the weight of an enum + migration
  // every time a new topic is wanted.
  category    String?
  status      LiveAudioRoomStatus @default(SCHEDULED)
  visibility  LiveAudioVisibility @default(PUBLIC)

  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Final stats, written once at ENDED (see room-service.ts) - not a
  // running counter updated on every join/leave, and not a separate
  // 1:1 "statistics" table: a handful of denormalized columns on the
  // room itself is simpler than a joined table for data this small.
  // Live/current counts are read directly from LiveAudioParticipant
  // (WHERE roomId AND leftAt IS NULL) - see the architecture doc's
  // Redis-vs-Postgres section for why that's not cached.
  peakListenerCount       Int @default(0)
  peakSpeakerCount        Int @default(0)
  totalUniqueParticipants Int @default(0)

  participants      LiveAudioParticipant[]
  speakerRequests   LiveAudioSpeakerRequest[]
  moderationActions LiveAudioModerationAction[]
  reports           Report[]

  // Discovery query: WHERE status = 'LIVE' AND visibility = 'PUBLIC'.
  @@index([visibility, status])
  // Cleanup cron query: WHERE status = 'LIVE'.
  @@index([status])
  // A community's "live now" surface.
  @@index([communityId])
  // "My rooms" / abuse investigation by host.
  @@index([hostId])
}

model LiveAudioParticipant {
  id String @id @default(cuid())

  roomId String
  room   LiveAudioRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("LiveAudioParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  role LiveAudioParticipantRole @default(LISTENER)

  // One row per (roomId, userId) for the room's whole lifetime, mutated
  // in place rather than inserted fresh on every join - see the
  // architecture doc for why this (not a partial/filtered unique index,
  // which Prisma's schema DSL cannot express) is how "no duplicate
  // active membership" is actually enforced: a second join can only
  // ever update this same row, never create a second one. "Currently
  // active" = leftAt IS NULL AND removedAt IS NULL.
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  isMuted  Boolean   @default(false)

  removedAt   DateTime?
  removedById String?
  removedBy   User?     @relation("LiveAudioParticipantRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  // Promote/demote/mute/remove all need "who are the current speakers/
  // moderators in this room".
  @@index([roomId, role])
  // "Which rooms is this user currently in" - the banned-user-mid-
  // session sweep uses this.
  @@index([userId])
}

model LiveAudioSpeakerRequest {
  id String @id @default(cuid())

  roomId String
  room   LiveAudioRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("LiveAudioSpeakerRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  status LiveAudioSpeakerRequestStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  resolvedById String?
  resolvedBy   User?   @relation("LiveAudioSpeakerRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  // One row per (roomId, userId) - a repeat request updates this row
  // back to PENDING rather than accumulating spam rows (also rate-
  // limited at the API layer - see room-service.ts).
  @@unique([roomId, userId])
  // The host/moderator "pending requests" queue for this room.
  @@index([roomId, status])
}

model LiveAudioModerationAction {
  id String @id @default(cuid())

  roomId String
  room   LiveAudioRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("LiveAudioModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  targetUserId String
  target       User   @relation("LiveAudioModerationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  action LiveAudioModerationActionType
  reason String?                       @db.Text

  createdAt DateTime @default(now())

  // Room audit trail.
  @@index([roomId])
  // "Has this user been actioned before" (in any room).
  @@index([targetUserId])
}

// ─── ZRP Live Video ────────────────────────────────────────────
// A separate section parallel to Live Audio (not a "video mode" bolted
// onto LiveAudioRoom) - same real-time-room architecture, camera feeds
// instead of audio-only. Deliberately reuses LiveAudioRoomStatus,
// LiveAudioVisibility, LiveAudioParticipantRole and
// LiveAudioSpeakerRequestStatus/LiveAudioModerationActionType as-is:
// their semantics (room lifecycle, visibility, "can this participant
// publish a track," moderation action types) are identical for video,
// and a second copy of each enum would only add migration surface with
// no behavioral difference. LISTENER/SPEAKER naming is a touch
// audio-flavored but drives the exact same canPublish grant in
// mintLiveKitToken() (src/lib/live-audio/livekit.ts), which is reused
// unchanged - LiveKit's publish grant already covers both audio and
// video tracks. The product-facing "Viewer"/"Participant" labels live
// in the translation layer, not the enum.
//
// Known, deliberate gap: unlike LiveAudioRoom, this is NOT one of
// Report's eight polymorphic target types (see the model comment on
// Report) - adding a ninth touches every target-type switch across
// admin/appeals, which is its own follow-up. A video room's host can
// still be reported today via the existing bare-profile report path.
model LiveVideoRoom {
  id String @id @default(cuid())

  hostId String
  host   User   @relation("LiveVideoHost", fields: [hostId], references: [id], onDelete: Cascade)

  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  title       String
  description String?             @db.Text
  category    String?
  status      LiveAudioRoomStatus @default(SCHEDULED)
  visibility  LiveAudioVisibility @default(PUBLIC)

  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same "final stats written once at ENDED, live counts read directly
  // from LiveVideoParticipant" pattern as LiveAudioRoom - see its own
  // comment for why.
  peakParticipantCount    Int @default(0)
  peakViewerCount         Int @default(0)
  totalUniqueParticipants Int @default(0)

  participants      LiveVideoParticipant[]
  speakerRequests   LiveVideoSpeakerRequest[]
  moderationActions LiveVideoModerationAction[]

  @@index([visibility, status])
  @@index([status])
  @@index([communityId])
  @@index([hostId])
}

model LiveVideoParticipant {
  id String @id @default(cuid())

  roomId String
  room   LiveVideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("LiveVideoParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  role LiveAudioParticipantRole @default(LISTENER)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  // Independent audio/video moderation flags - a camera and a mic are
  // two separate LiveKit tracks, each independently force-mutable by a
  // moderator (see muteParticipant/toggleParticipantCamera in
  // live-video/room-service.ts), unlike Live Audio which only ever has
  // the one (audio) track to moderate.
  isMuted     Boolean @default(false)
  isCameraOff Boolean @default(false)

  removedAt   DateTime?
  removedById String?
  removedBy   User?     @relation("LiveVideoParticipantRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  @@index([roomId, role])
  @@index([userId])
}

model LiveVideoSpeakerRequest {
  id String @id @default(cuid())

  roomId String
  room   LiveVideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("LiveVideoSpeakerRequestUser", fields: [userId], references: [id], onDelete: Cascade)

  status LiveAudioSpeakerRequestStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  resolvedById String?
  resolvedBy   User?   @relation("LiveVideoSpeakerRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  @@index([roomId, status])
}

model LiveVideoModerationAction {
  id String @id @default(cuid())

  roomId String
  room   LiveVideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("LiveVideoModerationActor", fields: [actorId], references: [id], onDelete: Cascade)

  targetUserId String
  target       User   @relation("LiveVideoModerationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  action LiveAudioModerationActionType
  reason String?                       @db.Text

  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([targetUserId])
}

// ─── ZRP Lists ─────────────────────────────────────────────────
// Twitter/X-style curated lists of users, owned by one account.
// A list's "feed" is the existing post feed filtered to the member
// users' authorId - no new post-tagging system needed here either.
model List {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  isPrivate   Boolean @default(false)

  ownerId String
  owner   User   @relation("ListOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members ListMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model ListMember {
  id String @id @default(cuid())

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ListMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([listId, userId])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════
// ZRP DISCOVER
// ════════════════════════════════════════════════════════════════════
//
// Backend foundation for ZRP's vertical-video discovery feed (V1). The
// content itself is NOT a new type - a "Discover item" is exactly the
// same Post row the existing Shorts feed (GET /api/videos) already
// serves (`type: POST`, `mediaType: "video"`), reused as-is rather than
// duplicated into a parallel video model. This section only adds what
// genuinely doesn't exist yet: a place to record watch/engagement
// events for those posts, which the ranking service can later read to
// evolve beyond the freshness+engagement V1 signals - see
// src/lib/discover/ for the feed/ranking/diversity/event services.

// One row per meaningful client-reported watch signal for a single
// Discover impression. Deliberately NOT split into 7 separate tables
// (one per event type) - that would just be the same polymorphic-target
// problem Report already solved, inverted. Kept intentionally light
// (no per-post aggregate columns here): V1 ranking reads the post's
// existing _count relations (likes/comments/reposts/bookmarks) plus
// freshness, so a Redis or Postgres outage on this table degrades
// analytics, never the feed itself. See DiscoverEventService
// (src/lib/discover/events.ts) for validation/dedup and
// src/app/api/discover/events/route.ts for the endpoint.
enum DiscoverEventType {
  IMPRESSION // the item entered the viewport (server-authorized existence check only)
  START // playback started
  PROGRESS_25
  PROGRESS_50
  PROGRESS_75
  COMPLETE // reached (approximately) the end
  SKIP // viewer swiped away before COMPLETE
}

model DiscoverEvent {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Nullable: Discover supports anonymous browsing (same as
  // /api/videos and /api/posts/explore today), and an anonymous
  // viewer's watch events are still worth recording in aggregate even
  // though they can't be tied to an account. SetNull (not Cascade) so
  // a later account deletion doesn't retroactively falsify historical
  // aggregate watch-time/completion-rate numbers for the content.
  userId String?
  user   User?   @relation("DiscoverEventUser", fields: [userId], references: [id], onDelete: SetNull)

  // ⚠️ SECURITY: the anonymous-caller half of DiscoverEventService's
  // dedup window (src/lib/discover/events.ts). userId alone cannot
  // dedup a signed-out caller - every anonymous request has
  // userId: null, so a scripted caller with no session could otherwise
  // spam unlimited IMPRESSION/START rows for the same post with zero
  // dedup, undermining the exact rank-inflation defense this table
  // exists for. Populated ONLY when userId is null (never store an IP
  // alongside a request we can already attribute to a real account -
  // minimizes retained PII to what's actually needed) - resolved via
  // the same trusted-proxy getRequestIp() every other rate-limited
  // route already uses, never trusted from a client-supplied field.
  ip String?

  eventType DiscoverEventType

  // Client-reported elapsed playback time at the moment of this event,
  // in milliseconds. Never trusted as authoritative on its own (a
  // client can lie), only ever used in aggregate - see the "Known
  // limitations" note in docs/discover-backend.md, the same
  // bounded-plausibility caveat ZRP PLAY's REACTION game documents for
  // client-reported timing it can't independently verify.
  watchedMs Int?

  createdAt DateTime @default(now())

  // Powers the dedup window in DiscoverEventService (one IMPRESSION/
  // START per viewer-or-IP per post per short window) and the future
  // avg-watch-time/completion-rate/skip-rate aggregation queries.
  @@index([postId, eventType])
  @@index([postId, createdAt])
  @@index([userId, postId, eventType, createdAt])
  @@index([ip, postId, eventType, createdAt])
}

// A viewer's "Not interested" on a single Discover post - content-level
// negative feedback, distinct from Mute/Blocked (both creator-level,
// already excluded from candidates.ts) and from moderation's Report
// (which asks staff to act on the content, not "show me less of this").
// Requires a signed-in viewer (unlike DiscoverEvent, which also accepts
// anonymous rows) since this is a stored personal preference, not
// passive analytics - there is nowhere to persist it for a signed-out
// visitor. Cascade on user deletion: it's that viewer's own preference,
// nothing else depends on it surviving their account.
model DiscoverDismissal {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}
