generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
  JOURNALIST
}

enum JournalistStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PostType {
  POST
  RECRUITMENT
  ARTICLE
}

enum TeamRole {
  ADMIN
  EDITOR
  VIEWER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum TicketCategory {
  GENERAL
  ACCOUNT
  PRIVACY
  CONTENT
  MODERATION
  PAYMENT
  MONETISATION
  BUG
  FEATURE_REQUEST
  SECURITY
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_REPLY
  RESOLVED
  CLOSED
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum AdBidType {
  CPC
  CPM
}

enum NewsArticleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum NewsArticleCategory {
  WORLD
  EUROPE
  SWITZERLAND
  POLITICS
  BUSINESS
  TECHNOLOGY
  CRYPTO
  SCIENCE
  SPORTS
  CULTURE
  COMMUNITY
}

enum ListingCategory {
  LUXURY_CARS
  YACHTS_BOATS
  PRIVATE_AIRCRAFT
  LUXURY_HOTELS_RESORTS
  LUXURY_REAL_ESTATE
  WATCHES_JEWELRY
  OTHER_LUXURY
}

// DRAFT is unused today (creation always goes straight to
// PENDING_REVIEW, same as AdCampaign) but kept for a future
// save-without-submitting flow, matching AdCampaignStatus's own
// unused-DRAFT precedent.
enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SOLD
  EXPIRED
  REMOVED
}

// ─── ZRP PLAY ──────────────────────────────────────────────────────

enum PlayChallengeType {
  TRIVIA
  MEMORY
  LOGIC
}

// Same live-immediately, reportable-after-the-fact model as Post
// (not the PENDING_REVIEW admin-approval gate used by Listing/AdCampaign) -
// challenge content is low-risk text/puzzle content, not a real-world
// commerce or ad-spend surface.
enum PlayChallengeStatus {
  ACTIVE
  REMOVED
}

enum PlayDuelStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  EXPIRED
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  username String  @unique
  password String?

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  emailVerified           DateTime?
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  pendingEmail            String?   @unique

  deletionRequestedAt DateTime?
  deletionScheduledFor DateTime?

  name      String?
  bio       String? @db.Text
  avatarUrl String? @db.Text
  coverUrl  String? @db.Text
  isPrivate Boolean @default(false)
  isAdmin   Boolean @default(false)
  badgeType String?

  category     String?
  showCategory Boolean @default(true)

  location          String?
  country           String?
  website           String?
  usernameChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role                Role    @default(USER)
  plan                String  @default("free")
  onboardingCompleted Boolean @default(false)
  banned              Boolean @default(false)

  publicLikes     Boolean @default(true)
  publicFollowing Boolean @default(true)

  customUrl String? @unique

  solanaWallet String?

  // ⚠️ SECURITY: cryptographically verified wallet ownership, used to
  // bind on-chain payments (tips, purchases) to the authenticated
  // account that actually controls the paying wallet - unlike
  // `solanaWallet` above, which is just an unverified payout address a
  // creator types into settings. Set only via the sign-a-nonce flow in
  // /api/wallet/link (see src/lib/wallet-link.ts).
  verifiedSolanaWallet   String?   @unique
  walletLinkNonce        String?
  walletLinkNonceExpiry  DateTime?

  emailPreferences Json?

  pinnedPostId String? @unique
  pinnedPost   Post?   @relation("PinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)

  posts    Post[]
  comments Comment[]

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  likes     Like[]
  reposts   Repost[]
  reactions Reaction[]

  muter   Mute[] @relation("Muter")
  mutedBy Mute[] @relation("Muted")

  notifications     Notification[] @relation("Notification_user")
  sentNotifications Notification[] @relation("Notification_fromUser")

  sentMessages     Message[] @relation("Message_sender")
  receivedMessages Message[] @relation("Message_receiver")

  messageReactions MessageReaction[]

  pollVotes PollVote[]
  bookmarks Bookmark[]

  pushSubscriptions PushSubscription[]

  stories    Story[]
  storyViews StoryView[]
  storyLikes StoryLike[]

  commentLikes     CommentLike[]
  commentReposts   CommentRepost[]
  commentBookmarks CommentBookmark[]

  upgradeRequests UpgradeRequest[]
  paymentRequests PaymentRequest[]

  blockedUsers Blocked[] @relation("Blocker")
  blockedBy    Blocked[] @relation("Blocked")

  reports         Report[] @relation("Reporter")
  reportsAgainstMe Report[] @relation("ReportTarget")
  appeals         Appeal[]

  listings         Listing[]         @relation("ListingSeller")
  listingFavorites ListingFavorite[]

  // ─── ZRP PLAY ──────────────────────────────────────────────
  playProfile        PlayProfile?
  playChallenges     PlayChallenge[]       @relation("PlayChallengeCreator")
  playAttempts       PlayAttempt[]
  playUserAchievements PlayUserAchievement[]
  duelsChallenged    PlayDuel[]            @relation("DuelChallenger")
  duelsReceived      PlayDuel[]            @relation("DuelOpponent")

  teamAccount TeamMember[] @relation("TeamAccount")
  teamMembers TeamMember[] @relation("TeamMemberUser")

  apiKeys ApiKey[]

  creatorProfile CreatorProfile?

  sentTips     Tip[] @relation("TipSender")
  receivedTips Tip[] @relation("TipRecipient")

  premiumPurchases PremiumPurchase[]

  withdrawalRequests WithdrawalRequest[]

  followRequestsSent     FollowRequest[] @relation("FollowRequester")
  followRequestsReceived FollowRequest[] @relation("FollowTarget")

  supportTickets  SupportTicket[]
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  ticketReplies   TicketReply[]

  aiConversations AIConversation[]
  aiDailyUsage    AIDailyUsage[]

  adCampaigns   AdCampaign[]   @relation("AdAdvertiser")
  adImpressions AdImpression[] @relation("AdImpressionUser")
  adClicks      AdClick[]      @relation("AdClickUser")

  newsArticles NewsArticle[] @relation("NewsAuthor")

  // ─── Journalist program ─────────────────────────────────────
  // A user's own journalist application/profile (present only if
  // they have ever applied to become a ZRP Journalist).
  journalistProfile JournalistProfile?

  // Journalist applications this user (an admin/moderator) has reviewed.
  journalistReviewsGiven JournalistProfile[] @relation("JournalistReviewedBy")

  // News articles this user (an admin/moderator) has reviewed
  // (approved/rejected) as part of the journalist submission workflow.
  newsReviewsGiven NewsArticle[] @relation("NewsReviewedBy")
}

model JournalistProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status JournalistStatus @default(PENDING)

  // Application details supplied by the applicant.
  outlet       String? @db.Text
  pitch        String? @db.Text
  portfolioUrl String?

  appliedAt DateTime @default(now())

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("JournalistReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  rejectionReason  String? @db.Text
  suspensionReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewedById])
}

model Post {
  id          String   @id @default(cuid())
  content     String   @db.Text
  imageUrl    String?
  imageUrls   String[] @default([])
  mediaType   String?
  linkUrl     String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotePostId String?
  quotePost   Post?  @relation("QuotePost", fields: [quotePostId], references: [id], onDelete: SetNull)
  quotedBy    Post[] @relation("QuotePost")

  views       Int       @default(0)
  scheduledAt DateTime?
  status      String    @default("published")

  hashtags String[]
  mentions String[]

  pollId String? @unique
  poll   Poll?   @relation(fields: [pollId], references: [id])
  isPoll Boolean @default(false)

  commentsEnabled Boolean @default(true)

  type     PostType @default(POST)
  company  String?
  location String?
  applyUrl String?
  body     String?  @db.Text

  pinnedBy User? @relation("PinnedPost")

  comments Comment[]
  likes    Like[]
  reposts  Repost[]
  reactions Reaction[]

  notifications Notification[] @relation("Notification_post")

  reports   Report[]
  bookmarks Bookmark[]

  premiumPost PremiumPost?
  adCampaign  AdCampaign?

  @@index([createdAt])
  @@index([authorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([quotePostId])
  @@index([type])
}

model Comment {
  id       String @id @default(cuid())
  content  String @db.Text
  imageUrl String?

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]

  likes     CommentLike[]
  reposts   CommentRepost[]
  bookmarks CommentBookmark[]

  @@index([postId])
  @@index([createdAt])
  @@index([parentId])
  @@index([authorId])
}

model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FollowRequest {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("FollowRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  targetId String
  target   User   @relation("FollowTarget", fields: [targetId], references: [id], onDelete: Cascade)

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, targetId])
  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

model Like {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Repost {
  id String @id @default(cuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  quoteContent String? @db.Text

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Reaction {
  id    String @id @default(cuid())
  emoji String

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@index([userId])
}

model Mute {
  id String @id @default(cuid())

  muterId String
  muter   User   @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)

  mutedId String
  muted   User   @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("Notification_user", fields: [userId], references: [id], onDelete: Cascade)

  type String

  fromUserId String
  fromUser   User   @relation("Notification_fromUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?  @relation("Notification_post", fields: [postId], references: [id], onDelete: Cascade)

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@index([fromUserId])
}

model Message {
  id String @id @default(cuid())

  content  String @db.Text
  imageUrl String?

  senderId String
  sender   User   @relation("Message_sender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User   @relation("Message_receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  read   Boolean @default(false)
  edited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  reactions MessageReaction[]

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([senderId, receiverId])
  @@index([replyToId])
}

model MessageReaction {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji String

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model Poll {
  id String @id @default(cuid())

  question String   @db.Text
  options  String[]

  votes Json?

  post Post?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes_user PollVote[]
}

model PollVote {
  id String @id @default(cuid())

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  optionIndex Int

  createdAt DateTime @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model Gif {
  id String @id @default(cuid())

  url    String
  title  String?
  width  Int?
  height Int?

  createdAt DateTime @default(now())
}

model Blocked {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // SetNull rather than Cascade: a moderation action that deletes the
  // reported post/comment must NOT also delete the Report row recording
  // why - that would erase the moderation-transparency audit trail (and
  // any appeal referencing it) at the exact moment the action it
  // describes is carried out.
  postId String?
  post   Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  reason  String
  details String? @db.Text

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actionType String?
  actionNote String? @db.Text
  actionedAt DateTime?

  // Denormalized at the moment an action is taken (see PUT
  // /api/admin/reports/[id]): the post/comment author may become
  // unreachable later (content deleted, SetNull above), but the person
  // an action was actually taken against must still be identifiable so
  // they can be shown - and file - an appeal.
  targetUserId String?
  targetUser   User?   @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Third optional polymorphic target, same pattern as postId/commentId
  // above - reuses this entire reporting/moderation/appeals/transparency
  // system for marketplace listings instead of building a parallel one.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  // Fourth polymorphic target, same pattern again - reuses the same
  // reporting/moderation system for ZRP PLAY user-created challenges.
  challengeId String?
  challenge   PlayChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  appeals Appeal[]

  @@index([postId])
  @@index([commentId])
  @@index([listingId])
  @@index([challengeId])
  @@index([status])
  @@index([reporterId])
  @@index([targetUserId])
}

model Appeal {
  id String @id @default(cuid())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String @db.Text

  status String @default("pending") // pending | upheld | overturned

  resolutionNote     String?   @db.Text
  resolvedById       String?
  resolvedByUsername String?
  resolvedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One appeal per user per actioned report - resubmission isn't how
  // this is meant to work; a denied appeal is final unless staff reopen
  // the underlying report.
  @@unique([reportId, userId])
  @@index([userId])
  @@index([status])
}

model Bookmark {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  keys     Json

  createdAt DateTime @default(now())

  @@index([userId])
}

model UpgradeRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  requestedPlan String
  paymentMethod String?
  message       String? @db.Text

  status String @default("pending")

  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PaymentRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan     String
  amount   Decimal @db.Decimal(18, 6)
  currency String @default("USDC")

  transactionId String?

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model CommentLike {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model CommentRepost {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model CommentBookmark {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Story {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content   String? @db.Text
  mediaUrl  String?
  mediaType String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  views StoryView[]
  likes StoryLike[]

  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
}

model StoryView {
  id String @id @default(cuid())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  viewerId String
  viewer   User   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@index([viewerId])
}

model StoryLike {
  id String @id @default(cuid())

  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  likerId String
  liker   User   @relation(fields: [likerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([storyId, likerId])
  @@index([storyId])
  @@index([likerId])
}

model TeamMember {
  id String @id @default(cuid())

  accountId String
  userId    String

  role TeamRole @default(VIEWER)

  createdAt DateTime @default(now())

  account User @relation("TeamAccount", fields: [accountId], references: [id], onDelete: Cascade)
  user    User @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
}

model ApiKey {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  keyHash String @unique
  name    String

  lastUsed  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())

  revoked Boolean @default(false)

  @@index([userId])
}

model CreatorProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tipsEnabled Boolean  @default(true)
  tipsMessage String? @db.Text

  premiumPostsEnabled Boolean @default(true)

  totalTips           Decimal @default(0) @db.Decimal(18, 6)
  totalPremiumRevenue Decimal @default(0) @db.Decimal(18, 6)
  totalEarnings       Decimal @default(0) @db.Decimal(18, 6)
  totalWithdrawn      Decimal @default(0) @db.Decimal(18, 6)
  balance             Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tips               Tip[]
  premiumPosts       PremiumPost[]
  withdrawalRequests WithdrawalRequest[]
}

model Tip {
  id String @id @default(cuid())

  senderId String
  sender   User   @relation("TipSender", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("TipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(18, 6)
  currency String @default("USDC")

  message String? @db.Text

  transactionId String? @unique

  status TransactionStatus @default(PENDING)

  platformFee   Decimal @default(0) @db.Decimal(18, 6)
  charityAmount Decimal @default(0) @db.Decimal(18, 6)
  creatorAmount Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId])
  @@index([senderId])
  @@index([status])
  @@index([createdAt])
  @@index([creatorProfileId])
}

model PremiumPost {
  id String @id @default(cuid())

  postId String @unique
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  price    Decimal @default(1.0) @db.Decimal(18, 6)
  currency String @default("USDC")

  previewContent String? @db.Text

  totalPurchases Int     @default(0)
  totalRevenue   Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases PremiumPurchase[]

  @@index([postId])
  @@index([price])
  @@index([creatorProfileId])
}

model PremiumPurchase {
  id String @id @default(cuid())

  premiumPostId String
  premiumPost   PremiumPost @relation(fields: [premiumPostId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(18, 6)
  currency String @default("USDC")

  transactionId String? @unique

  status TransactionStatus @default(PENDING)

  platformFee   Decimal @default(0) @db.Decimal(18, 6)
  charityAmount Decimal @default(0) @db.Decimal(18, 6)
  creatorAmount Decimal @default(0) @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([premiumPostId, userId])
  @@index([userId])
  @@index([premiumPostId])
  @@index([status])
}

model WithdrawalRequest {
  id String @id @default(cuid())

  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(18, 6)
  currency String @default("USDC")

  walletAddress String

  status WithdrawalStatus @default(PENDING)

  transactionHash String?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([creatorProfileId])
}

// ZRP Market Plus: luxury-only listings marketplace. Deliberately NOT
// a payments/escrow system - price is informational, a deal is closed
// off-platform between buyer and seller after they connect via the
// existing messaging system. Mirrors AdCampaign's moderation shape
// (PENDING_REVIEW by default, staff approve/reject, rejectionReason +
// reviewedBy/reviewedAt) since that's the closest existing analog to
// "user-submitted content that must pass moderation before going
// live" for something other than a Post.
model Listing {
  id String @id @default(cuid())

  sellerId String
  seller   User   @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  category    ListingCategory
  title       String
  description String          @db.Text

  // Either a real price or priceOnRequest - validated together at the
  // API layer, not enforceable as a DB constraint with Prisma alone.
  price          Decimal? @db.Decimal(18, 2)
  currency       String   @default("USD")
  priceOnRequest Boolean  @default(false)

  location String?

  imageUrls String[] @default([])
  videoUrl  String?

  status          ListingStatus @default(PENDING_REVIEW)
  rejectionReason String?       @db.Text
  reviewedBy      String?
  reviewedAt      DateTime?

  views Int @default(0)

  // Listings aren't meant to sit forever - a stale "for sale" luxury
  // asset is exactly the kind of thing that erodes trust in a
  // marketplace. Set on approval (90 days out); expired listings stop
  // showing in browse/search but aren't deleted.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites ListingFavorite[]
  reports   Report[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([status, category])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model ListingFavorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model AdCampaign {
  id String @id @default(cuid())

  advertiserId String
  advertiser   User   @relation("AdAdvertiser", fields: [advertiserId], references: [id], onDelete: Cascade)

  postId String @unique
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  name   String
  status AdCampaignStatus @default(DRAFT)

  bidType   AdBidType
  bidAmount Decimal @db.Decimal(18, 6)

  budgetTotal Decimal @db.Decimal(18, 6)
  budgetSpent Decimal @default(0) @db.Decimal(18, 6)

  targetUrl String?

  startDate DateTime?
  endDate   DateTime?

  rejectionReason String? @db.Text

  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impressions AdImpression[]
  clicks      AdClick[]

  @@index([advertiserId])
  @@index([status])
  @@index([status, startDate, endDate])
}

model AdImpression {
  id String @id @default(cuid())

  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation("AdImpressionUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([campaignId, createdAt])
  @@index([userId])
}

model AdClick {
  id String @id @default(cuid())

  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation("AdClickUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([campaignId, createdAt])
  @@index([userId])
}

model SupportTicket {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String

  category TicketCategory @default(GENERAL)
  priority TicketPriority @default(NORMAL)
  status   TicketStatus   @default(OPEN)

  message String @db.Text

  attachments String[]

  assignedTo String?

  assignedAdmin User? @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)

  resolvedAt DateTime?
  resolution String? @db.Text

  userAgent String?
  ipAddress String?
  referrer  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies  TicketReply[]
  feedback TicketFeedback?

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([status, priority])
}

model TicketReply {
  id String @id @default(cuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String @db.Text

  isInternal Boolean @default(false)

  attachments String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@index([isInternal])
}

model TicketFeedback {
  id String @id @default(cuid())

  ticketId String @unique
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  rating   Int?
  comment  String? @db.Text
  resolved Boolean?

  createdAt DateTime @default(now())
}

model AIConversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String @default("New Conversation")

  messages AIMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model AIMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String
  content String @db.Text
  model   String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model AIDailyUsage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @default(now())

  messages   Int @default(0)
  tokensUsed Int @default(0)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ─── ZRP NEWS ────────────────────────────────────────────────────────
// Dedicated editorial news system.
// Completely separate from Post, Shorts and Video systems.

model NewsArticle {
  id String @id @default(cuid())

  title String @db.Text
  slug  String @unique

  excerpt String? @db.Text
  content String  @db.Text

  coverImage String?

  sourceName String?
  sourceUrl  String?

  category NewsArticleCategory @default(WORLD)
  status   NewsArticleStatus   @default(DRAFT)

  authorId String
  author   User   @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  views Int @default(0)

  featured Boolean @default(false)

  publishedAt DateTime?

  // ─── Journalist editorial workflow ──────────────────────────
  // Set when a journalist submits a DRAFT for admin review.
  submittedAt DateTime?

  // Feedback left by the admin/moderator who reviewed the
  // submission: shown to the journalist, especially on rejection.
  reviewNote String? @db.Text

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("NewsReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@index([featured])
  @@index([authorId])
  @@index([status, publishedAt])
  @@index([category, publishedAt])
  @@index([reviewedById])
}

// ─── Admin Audit Log ────────────────────────────────────────────────
// Immutable record of sensitive administrator actions (moderation,
// role changes, payment/withdrawal decisions, account security
// events). Deliberately has no relation/FK to User: an audit trail
// must survive the actor or target account being deleted later, so it
// is never cascade-deleted along with them.
model AuditLog {
  id String @id @default(cuid())

  actorId       String
  actorUsername String?

  action     String // e.g. "user.ban", "user.role_change", "withdrawal.approve"
  targetType String? // e.g. "User", "WithdrawalRequest"
  targetId   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}

// A real, admin-recorded record of a charity disbursement ZRP actually
// made - never auto-generated, never estimated. This is deliberately
// separate from the automatically-computed "committed" figure (the sum
// of Tip.charityAmount / PremiumPurchase.charityAmount on completed
// transactions): committed is what the 35% policy owes so far, disbursed
// is proof money actually left ZRP and reached a real beneficiary.
model CharityDisbursement {
  id String @id @default(cuid())

  beneficiaryName String
  cause           String // matches one of the four /charity page categories
  amount          Decimal @db.Decimal(18, 2)
  currency        String  @default("USD")

  disbursedAt DateTime
  note        String? @db.Text
  proofUrl    String? // link to a receipt/confirmation the admin can point to

  recordedById       String
  recordedByUsername String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disbursedAt])
  @@index([cause])
}

// ─── ZRP PLAY ────────────────────────────────────────────────────────
// Social entertainment/gaming hub: quick challenges (trivia, memory,
// logic), 1v1 duels, XP/levels/streaks, achievements and leaderboards.
// Reuses User, Follow, Notification, Report/Appeal, Message and Post
// rather than building parallel systems for any of those.

model PlayChallenge {
  id String @id @default(cuid())

  // Null for system/daily challenges (including AI-generated ones with
  // no specific human author); SetNull rather than Cascade so a
  // deleted account doesn't take other players' history/leaderboard
  // entries with it - same reasoning as Post.author-adjacent deletes
  // elsewhere in this schema.
  creatorId String?
  creator   User?   @relation("PlayChallengeCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  type        PlayChallengeType
  title       String
  description String?           @db.Text
  difficulty  String            @default("medium") // easy | medium | hard

  // Shape depends on `type` instead of one table per mini-game:
  // TRIVIA: { questions: [{ q, options: string[], correctIndex }] }
  // MEMORY: { pairs: string[] } (each value appears twice, shuffled client-side)
  // LOGIC:  { prompt, options: string[], correctIndex } or { prompt, answer } for free text
  content Json

  maxScore      Int     @default(100)
  isDaily       Boolean @default(false)
  activeDate    DateTime? // date-only marker (UTC midnight) for the daily-challenge slot
  isAiGenerated Boolean @default(false)

  status        PlayChallengeStatus @default(ACTIVE)
  removedReason String?             @db.Text

  playCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts PlayAttempt[]
  duels    PlayDuel[]
  reports  Report[]

  @@index([type])
  @@index([status])
  @@index([isDaily, activeDate])
  @@index([creatorId])
  @@index([createdAt])
  @@index([playCount])
}

model PlayAttempt {
  id String @id @default(cuid())

  challengeId String
  challenge   PlayChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score    Int
  timeMs   Int
  xpEarned Int @default(0)

  // Set when this attempt is one side of a duel rather than a solo play.
  duelId String?
  duel   PlayDuel? @relation(fields: [duelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([challengeId])
  @@index([userId])
  @@index([duelId])
  @@index([userId, createdAt])
}

model PlayDuel {
  id String @id @default(cuid())

  challengeId String
  challenge   PlayChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  challengerId String
  challenger   User   @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)

  opponentId String
  opponent   User   @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  status PlayDuelStatus @default(PENDING)

  challengerScore Int?
  opponentScore   Int?
  winnerId        String?

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  completedAt DateTime?
  expiresAt   DateTime

  attempts PlayAttempt[]

  @@index([challengerId])
  @@index([opponentId])
  @@index([status])
  @@index([challengeId])
}

// One row per user - their overall PLAY stats. Kept separate from User
// itself (like CreatorProfile) so the core User model doesn't grow a
// gamification-specific column set.
model PlayProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp Int @default(0)
  level   Int @default(1)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastPlayedAt  DateTime?

  challengesCompleted Int @default(0)
  duelsWon            Int @default(0)
  duelsPlayed         Int @default(0)

  updatedAt DateTime @updatedAt

  @@index([totalXp])
}

// Unlocked achievements only - the achievement catalog itself (name,
// description, icon, XP reward, unlock criteria) is small, static and
// versioned in code (src/lib/play/achievements.ts), not the database,
// so shipping a new achievement never needs a data migration.
model PlayUserAchievement {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementKey String
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
  @@index([userId])
}
