*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Release upload keystore - never committed, exactly like android/.gitignore
# for the Capacitor app. The CI workflow decodes it from a GitHub Actions
# secret into keystore.properties at build time; it never exists in the
# working tree otherwise unless a developer drops a real one in locally.
*.jks
*.keystore
keystore.properties

# debug.keystore is the one deliberate exception to *.keystore above - see
# app/build.gradle's own comment on why a checked-in, stable debug signing
# cert is required for Google Sign-In to work on debug builds at all.
!debug.keystore
