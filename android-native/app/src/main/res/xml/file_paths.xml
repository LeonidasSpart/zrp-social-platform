<?xml version="1.0" encoding="utf-8"?>
<!--
    Backs the FileProvider declared in AndroidManifest.xml. Only exposes
    cacheDir/exports - the one directory SettingsRepository.exportData()
    writes into - not the app's whole cache.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="exports" path="exports/" />
</paths>
