<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required from Android 13 (API 33) onward for any app that posts
         notifications - requested at runtime from MainActivity once the
         user is signed in (see AuthState-gated LaunchedEffect there),
         not declaring this alone is enough. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice/video calling (Messaging parity) - requested at runtime
         right before a call starts or is accepted, matching the browser's
         own getUserMedia permission prompt at the same point in the flow. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Real background playback for ZRP Music (MusicPlaybackService) -
         lets ExoPlayer keep playing, with real lock-screen/notification
         controls, once the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- allowBackup="false": the encrypted session token in TokenStore is
         bound to this device's Android Keystore, but the (encrypted)
         preferences file itself, plus any other app data, must not be
         extractable through `adb backup` / device-to-device transfer -
         a backup of an authenticated session is exactly the kind of
         artifact the httpOnly cookie on the web can never become. -->
    <application
        android:name=".ZrpApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ZrpSocial"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZrpSocial"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Deep links into zrp.one URLs (profile pages, and the
                app's own core tabs) - handled by ZrpNavHost's deepLinks
                entries. Verified via android:autoVerify="true" below:
                release signing is now live (android-native-build.yml's
                release job, confirmed by its own "Release signing:
                CONFIGURED" log line), and public/.well-known/assetlinks.json
                publishes that release certificate's SHA-256 fingerprint
                for Android to check this intent-filter against on
                install. With verification, tapping a zrp.one link opens
                this app directly - no disambiguation dialog, and no
                need for the user to have manually set it as default.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zrp.one" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.ZrpFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- See MusicPlaybackService's own KDoc. exported="true" is
             required for MediaSessionService itself (system components -
             Bluetooth, Wear, Android Auto, the notification shade - bind
             to it), not a general access hole; androidx.media3 handles
             authorizing which callers may actually control playback. -->
        <service
            android:name=".service.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Used for any push that arrives without an explicit
             channel id (see ZrpFirebaseMessagingService's channel setup)
             so a plain data-only message still lands somewhere sane. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Backs AppCompatDelegate.setApplicationLocales() (the Language
             settings screen) with on-device persistence pre-API 33, where
             there's no framework LocaleManager to delegate to - without
             this, a picked language would reset to the system default on
             the next cold start on those OS versions. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Hands a content:// Uri to the share/view Intent Data Export
             (AccountSettingsScreen) launches after downloading the
             exported JSON into cacheDir/exports - the exported file
             itself is written by SettingsRepository.exportData(). Not
             exported: only this app can ever address these Uris, and
             grantUriPermissions scopes read access per-Intent to
             whichever app the user picks from the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
