<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ZrpApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ZrpSocial"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ZrpSocial"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Deep links into zrp.one URLs (profile pages, and the
                app's own core tabs) - handled by ZrpNavHost's deepLinks
                entries. Deliberately no android:autoVerify="true" yet:
                verified Android App Links need an assetlinks.json
                hosted at https://zrp.one/.well-known/ listing this
                app's release *signing certificate's* SHA-256
                fingerprint, and this app has no release signing
                configured yet (that's its own later, distinctly
                security-sensitive phase - see the migration plan's
                "native signing" step). Without verification, tapping a
                zrp.one link still offers this app as an option (via
                Android's normal disambiguation, or directly if the
                user has set it as the default handler); it just isn't
                automatic yet.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="zrp.one" />
            </intent-filter>
        </activity>

    </application>

</manifest>
